{"id": "sc900_mlc_q176", "exam": "SC-900", "domain": "security_compliance_identity", "objective": "security_compliance_concepts", "subobjective": "Describe the shared responsibility model", "difficulty": "beginner", "type": "multiple_choice", "stem": "In a PaaS web app, who is typically responsible for patching the application code and managing the app's identities and data?", "choices": [{"id": "b", "text": "Only the regional utility company"}, {"id": "c", "text": "A random internet stranger"}, {"id": "d", "text": "The hardware vendor of Microsoft's racks exclusively, with no customer duties"}, {"id": "a", "text": "The customer"}], "correct_answer": "a", "explanation": "Even in PaaS, customers remain responsible for their application, identities, and data. Microsoft manages more of the platform underneath.", "references": ["https://learn.microsoft.com/en-us/azure/security/fundamentals/shared-responsibility"], "tags": ["shared_responsibility_model", "paas_customer_still_owns_app_data"], "source": {"title": "Shared responsibility in the cloud - Microsoft Azure", "url": "https://learn.microsoft.com/en-us/azure/security/fundamentals/shared-responsibility"}, "metadata": {"origin": "manual", "batch": "mlc-batch-08", "blueprint_leaf_id": "shared_responsibility_model", "source_authority": "microsoft_docs", "source_urls": ["https://learn.microsoft.com/en-us/azure/security/fundamentals/shared-responsibility"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-security_compliance_concepts", "semantic_family_id": "shared_responsibility_model", "tested_decision": "paas_customer_still_owns_app_data", "misconception_target": "", "stem_style": "short_scenario", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_PRODUCT_DOC_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "doc-shared-responsibility"}}
{"id": "sc900_mlc_q177", "exam": "SC-900", "domain": "security_compliance_identity", "objective": "security_compliance_concepts", "subobjective": "Describe encryption and hashing", "difficulty": "intermediate", "type": "multiple_choice", "stem": "Digital signing is closest to which security goal?", "choices": [{"id": "a", "text": "Integrity and authenticity of data, using cryptography rather than reversible confidentiality alone"}, {"id": "b", "text": "Opening RDP to the internet"}, {"id": "c", "text": "Recertifying guest users"}, {"id": "d", "text": "Mitigating UDP floods"}], "correct_answer": "a", "explanation": "Signing supports integrity/authenticity. The SC-900 encryption-and-hashing lesson groups encryption, hashing, and signing as complementary cryptographic protections.", "references": ["https://learn.microsoft.com/en-us/training/modules/describe-security-concepts-methodologies/"], "tags": ["encryption_and_hashing", "signing_integrity_authenticity"], "source": {"title": "Describe Security Concepts and Methodologies", "url": "https://learn.microsoft.com/en-us/training/modules/describe-security-concepts-methodologies/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-08", "blueprint_leaf_id": "encryption_and_hashing", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/describe-security-concepts-methodologies/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-security_compliance_concepts", "semantic_family_id": "encryption_and_hashing", "tested_decision": "signing_integrity_authenticity", "misconception_target": "", "stem_style": "concept_distinction", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-describe-security-concepts-methodologies"}}
{"id": "sc900_mlc_q178", "exam": "SC-900", "domain": "security_compliance_identity", "objective": "identity_concepts", "subobjective": "Describe identity providers", "difficulty": "intermediate", "type": "multiple_choice", "stem": "Users sign in once to Microsoft Entra ID and then open several SaaS apps without storing passwords in each app. Which identity-provider benefit is that?", "choices": [{"id": "b", "text": "DDoS mitigation"}, {"id": "a", "text": "Single sign-on"}, {"id": "c", "text": "Records declaration"}, {"id": "d", "text": "NSG filtering"}], "correct_answer": "a", "explanation": "A shared identity provider enables SSO so apps trust issued tokens instead of local passwords.", "references": ["https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"], "tags": ["identity_providers", "idp_enables_sso"], "source": {"title": "Describe Identity Concepts", "url": "https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-08", "blueprint_leaf_id": "identity_providers", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-identity_concepts", "semantic_family_id": "federation_and_identity_providers", "tested_decision": "idp_enables_sso", "misconception_target": "", "stem_style": "short_scenario", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-describe-identity-principles-concepts"}}
