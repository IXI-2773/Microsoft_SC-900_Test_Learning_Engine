{"id": "sc900_mlc_q167", "exam": "SC-900", "domain": "microsoft_compliance_solutions", "objective": "purview_compliance_management", "subobjective": "Describe Compliance Manager", "difficulty": "intermediate", "type": "multiple_choice", "stem": "An organization must show progress implementing GDPR-related improvement actions. Which Purview tool is designed for that assessment workflow?", "choices": [{"id": "b", "text": "Azure Firewall"}, {"id": "a", "text": "Compliance Manager"}, {"id": "c", "text": "Defender for Endpoint"}, {"id": "d", "text": "Azure Bastion"}], "correct_answer": "a", "explanation": "Compliance Manager uses assessments and improvement actions against regulatory templates such as privacy regulations.", "references": ["https://learn.microsoft.com/en-us/purview/compliance-manager"], "tags": ["compliance_manager", "cm_gdpr_improvement_actions"], "source": {"title": "Microsoft Purview Compliance Manager", "url": "https://learn.microsoft.com/en-us/purview/compliance-manager"}, "metadata": {"origin": "manual", "batch": "mlc-batch-07", "blueprint_leaf_id": "compliance_manager", "source_authority": "microsoft_docs", "source_urls": ["https://learn.microsoft.com/en-us/purview/compliance-manager"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-purview_compliance_management", "semantic_family_id": "service_trust_privacy_compliance_manager", "tested_decision": "cm_gdpr_improvement_actions", "misconception_target": "", "stem_style": "short_scenario", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_PRODUCT_DOC_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "doc-compliance-manager"}}
{"id": "sc900_mlc_q168", "exam": "SC-900", "domain": "microsoft_compliance_solutions", "objective": "purview_information_protection_lifecycle", "subobjective": "Describe sensitivity labels and sensitivity label policies", "difficulty": "intermediate", "type": "multiple_choice", "stem": "Only the legal team should see a Highly Confidential label in Office apps. What determines which labels are published to which users?", "choices": [{"id": "b", "text": "NSG rules"}, {"id": "c", "text": "DDoS policies"}, {"id": "d", "text": "Bastion host SKUs"}, {"id": "a", "text": "Sensitivity label policies"}], "correct_answer": "a", "explanation": "Label policies publish labels to scoped users. Network and Bastion controls do not publish labels.", "references": ["https://learn.microsoft.com/en-us/training/modules/describe-purview-data-solutions/"], "tags": ["sensitivity_labels_and_policies", "label_policies_publish_to_users"], "source": {"title": "Describe the Data Security Solutions of Microsoft Purview", "url": "https://learn.microsoft.com/en-us/training/modules/describe-purview-data-solutions/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-07", "blueprint_leaf_id": "sensitivity_labels_and_policies", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/describe-purview-data-solutions/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-purview_information_protection_lifecycle", "semantic_family_id": "purview_information_protection_lifecycle", "tested_decision": "label_policies_publish_to_users", "misconception_target": "", "stem_style": "short_scenario", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-describe-purview-data-solutions"}}
{"id": "sc900_mlc_q169", "exam": "SC-900", "domain": "microsoft_compliance_solutions", "objective": "purview_information_protection_lifecycle", "subobjective": "Describe data loss prevention (DLP)", "difficulty": "intermediate", "type": "multiple_choice", "stem": "How does DLP differ from sensitivity labels at a fundamentals level?", "choices": [{"id": "b", "text": "DLP is only a directory role"}, {"id": "a", "text": "Labels classify and can protect content; DLP detects and helps prevent risky sharing of sensitive information"}, {"id": "c", "text": "Labels mitigate DDoS"}, {"id": "d", "text": "They are both Azure Firewall NAT rules"}], "correct_answer": "a", "explanation": "Labels mark/protect. DLP enforces sharing/exfiltration policies, often using those classifications.", "references": ["https://learn.microsoft.com/en-us/purview/dlp-learn-about-dlp"], "tags": ["data_loss_prevention", "labels_protect_dlp_prevents_sharing"], "source": {"title": "Learn about data loss prevention", "url": "https://learn.microsoft.com/en-us/purview/dlp-learn-about-dlp"}, "metadata": {"origin": "manual", "batch": "mlc-batch-07", "blueprint_leaf_id": "data_loss_prevention", "source_authority": "microsoft_docs", "source_urls": ["https://learn.microsoft.com/en-us/purview/dlp-learn-about-dlp"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-purview_information_protection_lifecycle", "semantic_family_id": "purview_information_protection_lifecycle", "tested_decision": "labels_protect_dlp_prevents_sharing", "misconception_target": "", "stem_style": "concept_distinction", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_PRODUCT_DOC_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "doc-dlp"}}
{"id": "sc900_mlc_q170", "exam": "SC-900", "domain": "microsoft_compliance_solutions", "objective": "purview_information_protection_lifecycle", "subobjective": "Describe retention policies, retention labels, and retention label policies", "difficulty": "intermediate", "type": "multiple_choice", "stem": "Which comparison between a retention policy and a retention label is accurate?", "choices": [{"id": "b", "text": "A policy is MFA; a label is WAF"}, {"id": "c", "text": "They both assign Entra roles"}, {"id": "a", "text": "A policy applies broadly to a location; a label can be applied to individual items"}, {"id": "d", "text": "A label is DDoS Protection"}], "correct_answer": "a", "explanation": "Policies are location-wide; labels target items, including user or auto application.", "references": ["https://learn.microsoft.com/en-us/training/modules/describe-purview-risk-compliance-governance/"], "tags": ["retention_policies_labels", "policy_location_label_item"], "source": {"title": "Describe the Data Compliance Solutions of Microsoft Purview", "url": "https://learn.microsoft.com/en-us/training/modules/describe-purview-risk-compliance-governance/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-07", "blueprint_leaf_id": "retention_policies_labels", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/describe-purview-risk-compliance-governance/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-purview_information_protection_lifecycle", "semantic_family_id": "purview_information_protection_lifecycle", "tested_decision": "policy_location_label_item", "misconception_target": "", "stem_style": "concept_distinction", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-describe-purview-risk-compliance-governance"}}
{"id": "sc900_mlc_q171", "exam": "SC-900", "domain": "microsoft_compliance_solutions", "objective": "purview_information_protection_lifecycle", "subobjective": "Describe records management", "difficulty": "intermediate", "type": "multiple_choice", "stem": "Why is a declared record more restrictive than an ordinary retained item?", "choices": [{"id": "b", "text": "Records cannot be stored in Microsoft 365"}, {"id": "a", "text": "Record status restricts editing and deletion during the retention period"}, {"id": "c", "text": "Records disable encryption"}, {"id": "d", "text": "Records replace authentication"}], "correct_answer": "a", "explanation": "Declaring a record locks down changes while retention applies. It does not forbid storage or encryption.", "references": ["https://learn.microsoft.com/en-us/purview/records-management"], "tags": ["records_management", "record_locks_vs_ordinary_retention"], "source": {"title": "Records management for documents and emails in Microsoft 365", "url": "https://learn.microsoft.com/en-us/purview/records-management"}, "metadata": {"origin": "manual", "batch": "mlc-batch-07", "blueprint_leaf_id": "records_management", "source_authority": "microsoft_docs", "source_urls": ["https://learn.microsoft.com/en-us/purview/records-management"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-purview_information_protection_lifecycle", "semantic_family_id": "purview_information_protection_lifecycle", "tested_decision": "record_locks_vs_ordinary_retention", "misconception_target": "", "stem_style": "concept_distinction", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_PRODUCT_DOC_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "doc-records-management"}}
{"id": "sc900_mlc_q172", "exam": "SC-900", "domain": "microsoft_compliance_solutions", "objective": "purview_insider_risk_ediscovery_audit", "subobjective": "Describe insider risk management", "difficulty": "intermediate", "type": "multiple_choice", "stem": "Which Insider Risk Management and eDiscovery pairing is accurate?", "choices": [{"id": "b", "text": "Both are Azure WAF policies"}, {"id": "c", "text": "Insider Risk Management is DDoS Protection"}, {"id": "d", "text": "eDiscovery issues TAP codes"}, {"id": "a", "text": "Insider Risk Management looks for internal risky behavior; eDiscovery collects content for legal matters"}], "correct_answer": "a", "explanation": "Those Purview solutions address different problems: insider behavior versus legal collection.", "references": ["https://learn.microsoft.com/en-us/purview/insider-risk-management"], "tags": ["insider_risk_management", "irm_behavior_vs_ediscovery_legal"], "source": {"title": "Learn about Insider Risk Management", "url": "https://learn.microsoft.com/en-us/purview/insider-risk-management"}, "metadata": {"origin": "manual", "batch": "mlc-batch-07", "blueprint_leaf_id": "insider_risk_management", "source_authority": "microsoft_docs", "source_urls": ["https://learn.microsoft.com/en-us/purview/insider-risk-management"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-purview_insider_risk_ediscovery_audit", "semantic_family_id": "purview_audit_ediscovery_insider_risk", "tested_decision": "irm_behavior_vs_ediscovery_legal", "misconception_target": "", "stem_style": "concept_distinction", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_PRODUCT_DOC_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "doc-insider-risk"}}
{"id": "sc900_mlc_q173", "exam": "SC-900", "domain": "microsoft_compliance_solutions", "objective": "purview_insider_risk_ediscovery_audit", "subobjective": "Describe audit solutions in Microsoft Purview", "difficulty": "intermediate", "type": "multiple_choice", "stem": "Why is audit not a substitute for DLP?", "choices": [{"id": "a", "text": "Audit records what happened; DLP is designed to prevent or constrain risky sharing as it happens"}, {"id": "b", "text": "Audit encrypts NSGs"}, {"id": "c", "text": "DLP recertifies roles"}, {"id": "d", "text": "They are identical"}], "correct_answer": "a", "explanation": "Audit is detective/historical. DLP is a preventive sharing control.", "references": ["https://learn.microsoft.com/en-us/purview/audit-solutions-overview"], "tags": ["audit", "audit_detective_dlp_preventive"], "source": {"title": "Learn about auditing solutions in Microsoft Purview", "url": "https://learn.microsoft.com/en-us/purview/audit-solutions-overview"}, "metadata": {"origin": "manual", "batch": "mlc-batch-07", "blueprint_leaf_id": "audit", "source_authority": "microsoft_docs", "source_urls": ["https://learn.microsoft.com/en-us/purview/audit-solutions-overview"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-purview_insider_risk_ediscovery_audit", "semantic_family_id": "purview_audit_ediscovery_insider_risk", "tested_decision": "audit_detective_dlp_preventive", "misconception_target": "", "stem_style": "concept_distinction", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_PRODUCT_DOC_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "doc-audit"}}
{"id": "sc900_mlc_q174", "exam": "SC-900", "domain": "microsoft_compliance_solutions", "objective": "purview_insider_risk_ediscovery_audit", "subobjective": "Describe eDiscovery solutions in Microsoft Purview", "difficulty": "intermediate", "type": "multiple_choice", "stem": "Which task is eDiscovery rather than Insider Risk Management?", "choices": [{"id": "a", "text": "Placing a legal hold on a custodian's mailbox and exporting results for counsel"}, {"id": "b", "text": "Scoring whether an employee is exfiltrating files to a personal cloud"}, {"id": "c", "text": "Mitigating a DDoS flood"}, {"id": "d", "text": "Resetting an Entra password"}], "correct_answer": "a", "explanation": "Legal hold and export are eDiscovery. Exfiltration scoring is closer to insider risk. DDoS and password reset are unrelated.", "references": ["https://learn.microsoft.com/en-us/training/modules/describe-purview-risk-compliance-governance/"], "tags": ["ediscovery", "legal_hold_is_ediscovery"], "source": {"title": "Describe the Data Compliance Solutions of Microsoft Purview", "url": "https://learn.microsoft.com/en-us/training/modules/describe-purview-risk-compliance-governance/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-07", "blueprint_leaf_id": "ediscovery", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/describe-purview-risk-compliance-governance/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-purview_insider_risk_ediscovery_audit", "semantic_family_id": "purview_audit_ediscovery_insider_risk", "tested_decision": "legal_hold_is_ediscovery", "misconception_target": "", "stem_style": "concept_distinction", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-describe-purview-risk-compliance-governance"}}
{"id": "sc900_mlc_q175", "exam": "SC-900", "domain": "microsoft_compliance_solutions", "objective": "purview_information_protection_lifecycle", "subobjective": "Describe the data classification capabilities", "difficulty": "intermediate", "type": "multiple_choice", "stem": "Before creating DLP or label policies, the team wants to know whether the tenant actually contains health data. Which capability answers that?", "choices": [{"id": "b", "text": "Azure Bastion"}, {"id": "c", "text": "Privileged Identity Management"}, {"id": "d", "text": "Azure Firewall"}, {"id": "a", "text": "Data classification"}], "correct_answer": "a", "explanation": "Classification discovers what sensitive data exists. Bastion, PIM, and Firewall do not inventory health data in content.", "references": ["https://learn.microsoft.com/en-us/training/modules/describe-purview-data-solutions/"], "tags": ["data_classification", "classify_before_dlp_to_know_what_exists"], "source": {"title": "Describe the Data Security Solutions of Microsoft Purview", "url": "https://learn.microsoft.com/en-us/training/modules/describe-purview-data-solutions/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-07", "blueprint_leaf_id": "data_classification", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/describe-purview-data-solutions/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-purview_information_protection_lifecycle", "semantic_family_id": "purview_information_protection_lifecycle", "tested_decision": "classify_before_dlp_to_know_what_exists", "misconception_target": "", "stem_style": "short_scenario", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-describe-purview-data-solutions"}}
