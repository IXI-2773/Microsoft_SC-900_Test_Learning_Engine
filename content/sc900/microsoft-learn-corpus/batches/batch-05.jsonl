{"id": "sc900_mlc_q101", "exam": "SC-900", "domain": "microsoft_security_solutions", "objective": "azure_infrastructure_security", "subobjective": "Describe Azure DDoS Protection", "difficulty": "intermediate", "type": "multiple_choice", "stem": "A site is slow because of a UDP flood against its public IP, not because of malicious HTTP payloads. Which control is aimed at that class of attack?", "choices": [{"id": "a", "text": "Azure DDoS Protection"}, {"id": "b", "text": "Azure Web Application Firewall"}, {"id": "c", "text": "Microsoft Entra ID Governance"}, {"id": "d", "text": "Purview audit"}], "correct_answer": "a", "explanation": "Volumetric UDP floods are a DDoS Protection problem. WAF inspects HTTP application attacks, not L3/L4 floods.", "references": ["https://learn.microsoft.com/en-us/training/modules/describe-basic-security-capabilities-azure/"], "tags": ["azure_ddos_protection", "ddos_not_waf_for_udp_flood"], "source": {"title": "Describe Core Infrastructure Security Services in Azure", "url": "https://learn.microsoft.com/en-us/training/modules/describe-basic-security-capabilities-azure/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-05", "blueprint_leaf_id": "azure_ddos_protection", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/describe-basic-security-capabilities-azure/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-azure_infrastructure_security", "semantic_family_id": "azure_nsg_firewall_waf_ddos", "tested_decision": "ddos_not_waf_for_udp_flood", "misconception_target": "", "stem_style": "concept_distinction", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-describe-basic-security-capabilities-azure"}}
