{"id": "sc900_mlc_q026", "exam": "SC-900", "domain": "microsoft_entra", "objective": "entra_authentication", "subobjective": "Describe password protection and management capabilities", "difficulty": "beginner", "type": "multiple_choice", "stem": "Which Entra capability is designed to block globally banned and organization-specific weak passwords?", "choices": [{"id": "b", "text": "Azure Bastion"}, {"id": "c", "text": "Content explorer"}, {"id": "d", "text": "Defender for Office 365"}, {"id": "a", "text": "Microsoft Entra Password Protection"}], "correct_answer": "a", "explanation": "Password Protection bans known weak and custom banned passwords. Bastion, Content explorer, and Defender for Office 365 do not perform that password-quality function.", "references": ["https://learn.microsoft.com/en-us/entra/identity/authentication/concept-password-ban-bad"], "tags": ["password_protection_management", "password_protection_bans_weak_passwords"], "source": {"title": "Password protection in Microsoft Entra ID - Microsoft Entra ID", "url": "https://learn.microsoft.com/en-us/entra/identity/authentication/concept-password-ban-bad"}, "metadata": {"origin": "manual", "batch": "mlc-batch-02", "blueprint_leaf_id": "password_protection_management", "source_authority": "microsoft_docs", "source_urls": ["https://learn.microsoft.com/en-us/entra/identity/authentication/concept-password-ban-bad"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-entra_authentication", "semantic_family_id": "password_protection_management", "tested_decision": "password_protection_bans_weak_passwords", "misconception_target": "", "stem_style": "capability_selection", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_PRODUCT_DOC_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "doc-password-protection"}}
{"id": "sc900_mlc_q027", "exam": "SC-900", "domain": "microsoft_entra", "objective": "entra_authentication", "subobjective": "Describe password protection and management capabilities", "difficulty": "intermediate", "type": "multiple_choice", "stem": "Users forget passwords and the help desk is overloaded. Which Entra capability lets users reset their own passwords after proving alternative methods?", "choices": [{"id": "b", "text": "Azure DDoS Protection"}, {"id": "a", "text": "Self-service password reset"}, {"id": "c", "text": "Records management"}, {"id": "d", "text": "Microsoft Defender Threat Intelligence"}], "correct_answer": "a", "explanation": "SSPR lets users unlock or reset passwords themselves after verifying other authentication methods.", "references": ["https://learn.microsoft.com/en-us/entra/identity/authentication/concept-sspr-howitworks"], "tags": ["password_protection_management", "sspr_reduces_helpdesk_resets"], "source": {"title": "Self-service password reset deep dive - Microsoft Entra ID", "url": "https://learn.microsoft.com/en-us/entra/identity/authentication/concept-sspr-howitworks"}, "metadata": {"origin": "manual", "batch": "mlc-batch-02", "blueprint_leaf_id": "password_protection_management", "source_authority": "microsoft_docs", "source_urls": ["https://learn.microsoft.com/en-us/entra/identity/authentication/concept-sspr-howitworks"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-entra_authentication", "semantic_family_id": "password_protection_management", "tested_decision": "sspr_reduces_helpdesk_resets", "misconception_target": "", "stem_style": "short_scenario", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_PRODUCT_DOC_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "doc-sspr"}}
{"id": "sc900_mlc_q028", "exam": "SC-900", "domain": "microsoft_entra", "objective": "entra_access_management", "subobjective": "Describe Microsoft Entra Conditional Access", "difficulty": "beginner", "type": "multiple_choice", "stem": "Which Microsoft Entra capability uses if-then policies based on user, device, location, and risk signals?", "choices": [{"id": "b", "text": "Azure Key Vault"}, {"id": "a", "text": "Conditional Access"}, {"id": "c", "text": "Purview eDiscovery"}, {"id": "d", "text": "Azure Firewall"}], "correct_answer": "a", "explanation": "Conditional Access evaluates identity and context signals and then allows, blocks, or requires controls such as MFA.", "references": ["https://learn.microsoft.com/en-us/entra/identity/conditional-access/overview"], "tags": ["conditional_access", "ca_if_then_signal_policies"], "source": {"title": "Microsoft Entra Conditional Access: Zero Trust Policy Engine - Microsoft Entra ID", "url": "https://learn.microsoft.com/en-us/entra/identity/conditional-access/overview"}, "metadata": {"origin": "manual", "batch": "mlc-batch-02", "blueprint_leaf_id": "conditional_access", "source_authority": "microsoft_docs", "source_urls": ["https://learn.microsoft.com/en-us/entra/identity/conditional-access/overview"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-entra_access_management", "semantic_family_id": "conditional_access_and_identity_protection", "tested_decision": "ca_if_then_signal_policies", "misconception_target": "", "stem_style": "direct_concept", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_PRODUCT_DOC_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "doc-conditional-access"}}
{"id": "sc900_mlc_q029", "exam": "SC-900", "domain": "microsoft_entra", "objective": "entra_access_management", "subobjective": "Describe Microsoft Entra Conditional Access", "difficulty": "intermediate", "type": "multiple_choice", "stem": "Finance users must complete MFA when they sign in from outside named locations. Which Entra capability enforces that requirement?", "choices": [{"id": "a", "text": "A retention label policy"}, {"id": "c", "text": "Azure Web Application Firewall"}, {"id": "b", "text": "Conditional Access"}, {"id": "d", "text": "Service Trust Portal"}], "correct_answer": "b", "explanation": "Requiring MFA based on user and location is a Conditional Access decision. Retention, WAF, and STP do not evaluate those sign-in signals.", "references": ["https://learn.microsoft.com/en-us/training/modules/explore-access-management-capabilities/"], "tags": ["conditional_access", "ca_requires_mfa_from_untrusted_location"], "source": {"title": "Describe Access Management Capabilities of Microsoft Entra", "url": "https://learn.microsoft.com/en-us/training/modules/explore-access-management-capabilities/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-02", "blueprint_leaf_id": "conditional_access", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/explore-access-management-capabilities/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-entra_access_management", "semantic_family_id": "conditional_access_and_identity_protection", "tested_decision": "ca_requires_mfa_from_untrusted_location", "misconception_target": "", "stem_style": "short_scenario", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-explore-access-management-capabilities"}}
{"id": "sc900_mlc_q030", "exam": "SC-900", "domain": "microsoft_entra", "objective": "entra_access_management", "subobjective": "Describe Microsoft Entra roles and role-based access control (RBAC)", "difficulty": "intermediate", "type": "multiple_choice", "stem": "Which statement correctly distinguishes Microsoft Entra roles from Azure resource RBAC?", "choices": [{"id": "a", "text": "Entra roles govern directory and identity administration; Azure RBAC governs access to Azure subscriptions and resources"}, {"id": "b", "text": "They are identical and always assigned together"}, {"id": "c", "text": "Azure RBAC replaces MFA"}, {"id": "d", "text": "Entra roles only apply to printers"}], "correct_answer": "a", "explanation": "Entra roles are for identity/directory administration. Azure RBAC is for Azure resource access. They are related least-privilege systems but not the same assignment plane.", "references": ["https://learn.microsoft.com/en-us/entra/identity/role-based-access-control/custom-overview"], "tags": ["entra_roles_rbac", "entra_roles_vs_azure_rbac_planes"], "source": {"title": "Overview of Microsoft Entra role-based access control (RBAC) - Microsoft Entra ID", "url": "https://learn.microsoft.com/en-us/entra/identity/role-based-access-control/custom-overview"}, "metadata": {"origin": "manual", "batch": "mlc-batch-02", "blueprint_leaf_id": "entra_roles_rbac", "source_authority": "microsoft_docs", "source_urls": ["https://learn.microsoft.com/en-us/entra/identity/role-based-access-control/custom-overview"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-entra_access_management", "semantic_family_id": "entra_roles_rbac", "tested_decision": "entra_roles_vs_azure_rbac_planes", "misconception_target": "", "stem_style": "concept_distinction", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_PRODUCT_DOC_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "doc-entra-rbac"}}
{"id": "sc900_mlc_q031", "exam": "SC-900", "domain": "microsoft_entra", "objective": "entra_access_management", "subobjective": "Describe Microsoft Entra roles and role-based access control (RBAC)", "difficulty": "beginner", "type": "multiple_choice", "stem": "Why should an organization avoid making every IT staff member a Global Administrator?", "choices": [{"id": "b", "text": "Because Global Administrator cannot sign in to Microsoft 365"}, {"id": "c", "text": "Because roles cannot be assigned in Entra ID"}, {"id": "d", "text": "Because encryption forbids administrators"}, {"id": "a", "text": "Because Entra RBAC supports assigning only the directory role needed for the job"}], "correct_answer": "a", "explanation": "Least privilege means using the smallest Entra role that can do the work instead of standing Global Administrator rights for everyone.", "references": ["https://learn.microsoft.com/en-us/training/modules/explore-access-management-capabilities/"], "tags": ["entra_roles_rbac", "least_privilege_not_everyone_ga"], "source": {"title": "Describe Access Management Capabilities of Microsoft Entra", "url": "https://learn.microsoft.com/en-us/training/modules/explore-access-management-capabilities/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-02", "blueprint_leaf_id": "entra_roles_rbac", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/explore-access-management-capabilities/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-entra_access_management", "semantic_family_id": "entra_roles_rbac", "tested_decision": "least_privilege_not_everyone_ga", "misconception_target": "", "stem_style": "governance_compliance", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-explore-access-management-capabilities"}}
{"id": "sc900_mlc_q032", "exam": "SC-900", "domain": "microsoft_entra", "objective": "entra_identity_protection_governance", "subobjective": "Describe Microsoft Entra ID Governance", "difficulty": "beginner", "type": "multiple_choice", "stem": "Which Microsoft Entra family of capabilities is designed for governing identity lifecycle and access over time?", "choices": [{"id": "a", "text": "Microsoft Entra ID Governance"}, {"id": "b", "text": "Azure DDoS Protection"}, {"id": "c", "text": "Microsoft Defender for Office 365"}, {"id": "d", "text": "Network security groups"}], "correct_answer": "a", "explanation": "ID Governance covers lifecycle, entitlement, access reviews, and related access-over-time controls, not network or email threat protection.", "references": ["https://learn.microsoft.com/en-us/entra/id-governance/identity-governance-overview"], "tags": ["entra_id_governance", "id_governance_family"], "source": {"title": "Microsoft Entra ID Governance - Microsoft Entra ID Governance", "url": "https://learn.microsoft.com/en-us/entra/id-governance/identity-governance-overview"}, "metadata": {"origin": "manual", "batch": "mlc-batch-02", "blueprint_leaf_id": "entra_id_governance", "source_authority": "microsoft_docs", "source_urls": ["https://learn.microsoft.com/en-us/entra/id-governance/identity-governance-overview"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-entra_identity_protection_governance", "semantic_family_id": "entra_id_governance_and_access_reviews", "tested_decision": "id_governance_family", "misconception_target": "", "stem_style": "capability_selection", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_PRODUCT_DOC_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "doc-id-governance"}}
{"id": "sc900_mlc_q033", "exam": "SC-900", "domain": "microsoft_entra", "objective": "entra_identity_protection_governance", "subobjective": "Describe Microsoft Entra ID Governance", "difficulty": "intermediate", "type": "multiple_choice", "stem": "When employees change departments, their app access should be adjusted automatically. Which ID Governance capability is built for joiner/mover/leaver automation?", "choices": [{"id": "a", "text": "Lifecycle Workflows"}, {"id": "b", "text": "Azure Firewall DNAT rules"}, {"id": "c", "text": "Content explorer"}, {"id": "d", "text": "Defender TI articles"}], "correct_answer": "a", "explanation": "Lifecycle Workflows automate joiner, mover, and leaver tasks. Firewall DNAT, Content explorer, and threat intel are unrelated.", "references": ["https://learn.microsoft.com/en-us/entra/id-governance/what-are-lifecycle-workflows"], "tags": ["entra_id_governance", "lifecycle_workflows_mover_automation"], "source": {"title": "What are lifecycle workflows? - Microsoft Entra ID Governance", "url": "https://learn.microsoft.com/en-us/entra/id-governance/what-are-lifecycle-workflows"}, "metadata": {"origin": "manual", "batch": "mlc-batch-02", "blueprint_leaf_id": "entra_id_governance", "source_authority": "microsoft_docs", "source_urls": ["https://learn.microsoft.com/en-us/entra/id-governance/what-are-lifecycle-workflows"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-entra_identity_protection_governance", "semantic_family_id": "entra_id_governance_and_access_reviews", "tested_decision": "lifecycle_workflows_mover_automation", "misconception_target": "", "stem_style": "short_scenario", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_PRODUCT_DOC_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "doc-lifecycle-workflows"}}
