{"id": "sc900_mlc_q035", "exam": "SC-900", "domain": "microsoft_entra", "objective": "entra_identity_protection_governance", "subobjective": "Describe the capabilities of Microsoft Entra Privileged Identity Management", "difficulty": "intermediate", "type": "multiple_choice", "stem": "Admins currently hold permanent Privileged Role Administrator rights even on days they do no directory work. Which Entra capability is designed to replace that standing access with time-bound activation?", "choices": [{"id": "b", "text": "Azure Web Application Firewall"}, {"id": "a", "text": "Privileged Identity Management"}, {"id": "c", "text": "Microsoft Purview Audit"}, {"id": "d", "text": "Defender for Cloud Apps"}], "correct_answer": "a", "explanation": "PIM provides just-in-time, time-bound, approval-capable activation of privileged roles instead of standing assignment.", "references": ["https://learn.microsoft.com/en-us/entra/id-governance/privileged-identity-management/pim-configure"], "tags": ["privileged_identity_management", "pim_replaces_standing_privilege"], "source": {"title": "What is Privileged Identity Management? - Microsoft Entra ID Governance", "url": "https://learn.microsoft.com/en-us/entra/id-governance/privileged-identity-management/pim-configure"}, "metadata": {"origin": "manual", "batch": "mlc-batch-02", "blueprint_leaf_id": "privileged_identity_management", "source_authority": "microsoft_docs", "source_urls": ["https://learn.microsoft.com/en-us/entra/id-governance/privileged-identity-management/pim-configure"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-entra_identity_protection_governance", "semantic_family_id": "privileged_identity_management", "tested_decision": "pim_replaces_standing_privilege", "misconception_target": "", "stem_style": "short_scenario", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_PRODUCT_DOC_PRIMARY", "currentness_stat