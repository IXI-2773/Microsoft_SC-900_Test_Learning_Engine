{"id": "sc900_mlc_q037", "exam": "SC-900", "domain": "microsoft_entra", "objective": "entra_identity_types_and_function", "subobjective": "Describe types of identities, including agent ID", "difficulty": "beginner", "type": "multiple_choice", "stem": "Which set lists identity types that Microsoft Entra ID can represent?", "choices": [{"id": "b", "text": "Only NSGs and firewalls"}, {"id": "c", "text": "Only sensitivity labels"}, {"id": "d", "text": "Only Sentinel workbooks"}, {"id": "a", "text": "Users, workload/application identities, devices, and agent identities"}], "correct_answer": "a", "explanation": "Entra ID represents people, apps/workloads, devices, and now agent identities. Network and compliance objects are not Entra identity types.", "references": ["https://learn.microsoft.com/en-us/training/modules/explore-basic-services-identity-types/"], "tags": ["identity_types_including_agent_id", "entra_identity_type_set"], "source": {"title": "Describe the Function and Identity Types of Microsoft Entra ID", "url": "https://learn.microsoft.com/en-us/training/modules/explore-basic-services-identity-types/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-02", "blueprint_leaf_id": "identity_types_including_agent_id", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/explore-basic-services-identity-types/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-entra_identity_types_and_function", "semantic_family_id": "identity_types_including_agent_id", "tested_decision": "entra_identity_type_set", "misconception_target": "", "stem_style": "direct_concept", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-explore-basic-services-identity-types"}}
{"id": "sc900_mlc_q038", "exam": "SC-900", "domain": "microsoft_entra", "objective": "entra_identity_types_and_function", "subobjective": "Describe hybrid identity", "difficulty": "intermediate", "type": "multiple_choice", "stem": "Which statement about hybrid identity is correct?", "choices": [{"id": "b", "text": "Hybrid identity lets on-premises identities be used with Entra ID and cloud apps"}, {"id": "a", "text": "Hybrid identity requires deleting Active Directory Domain Services on day one"}, {"id": "c", "text": "Hybrid identity is a Purview eDiscovery case type"}, {"id": "d", "text": "Hybrid identity replaces encryption"}], "correct_answer": "b", "explanation": "Hybrid identity connects AD DS identities to Entra ID. It does not require immediately removing AD DS or changing eDiscovery/encryption products.", "references": ["https://learn.microsoft.com/en-us/training/modules/explore-basic-services-identity-types/"], "tags": ["hybrid_identity", "hybrid_keeps_ad_ds_connected"], "source": {"title": "Describe the Function and Identity Types of Microsoft Entra ID", "url": "https://learn.microsoft.com/en-us/training/modules/explore-basic-services-identity-types/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-02", "blueprint_leaf_id": "hybrid_identity", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/explore-basic-services-identity-types/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-entra_identity_types_and_function", "semantic_family_id": "entra_hybrid_identity_and_ad", "tested_decision": "hybrid_keeps_ad_ds_connected", "misconception_target": "", "stem_style": "misconception_correction", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-explore-basic-services-identity-types"}}
{"id": "sc900_mlc_q039", "exam": "SC-900", "domain": "microsoft_entra", "objective": "entra_authentication", "subobjective": "Describe the authentication methods", "difficulty": "beginner", "type": "multiple_choice", "stem": "A help desk needs a short-lived sign-in method so a new hire can register Authenticator. Which method is designed for that bootstrap?", "choices": [{"id": "b", "text": "A DLP policy"}, {"id": "c", "text": "An NSG deny-all rule"}, {"id": "a", "text": "Temporary Access Pass"}, {"id": "d", "text": "A Defender TI indicator"}], "correct_answer": "a", "explanation": "Temporary Access Pass is a time-limited passcode for bootstrapping passwordless registration. DLP, NSGs, and threat intel are not sign-in methods.", "references": ["https://learn.microsoft.com/en-us/entra/identity/authentication/howto-authentication-temporary-access-pass"], "tags": ["authentication_methods", "tap_bootstrap_new_hire_registration"], "source": {"title": "Configure a Temporary Access Pass in Microsoft Entra ID to register passwordless authentication methods - Microsoft Entra ID", "url": "https://learn.microsoft.com/en-us/entra/identity/authentication/howto-authentication-temporary-access-pass"}, "metadata": {"origin": "manual", "batch": "mlc-batch-02", "blueprint_leaf_id": "authentication_methods", "source_authority": "microsoft_docs", "source_urls": ["https://learn.microsoft.com/en-us/entra/identity/authentication/howto-authentication-temporary-access-pass"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-entra_authentication", "semantic_family_id": "authentication_methods", "tested_decision": "tap_bootstrap_new_hire_registration", "misconception_target": "", "stem_style": "short_scenario", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_PRODUCT_DOC_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "doc-temporary-access-pass"}}
{"id": "sc900_mlc_q040", "exam": "SC-900", "domain": "microsoft_entra", "objective": "entra_authentication", "subobjective": "Describe multifactor authentication (MFA)", "difficulty": "intermediate", "type": "multiple_choice", "stem": "A user enters a password and then scans a fingerprint. Why does that qualify as MFA?", "choices": [{"id": "b", "text": "Because the fingerprint replaces authorization"}, {"id": "c", "text": "Because hashing occurred"}, {"id": "a", "text": "Because two different factor categories are combined"}, {"id": "d", "text": "Because a WAF inspected the request"}], "correct_answer": "a", "explanation": "MFA combines distinct factor categories such as knowledge and inherence. The second factor is not authorization, hashing, or WAF inspection.", "references": ["https://learn.microsoft.com/en-us/training/modules/explore-authentication-capabilities/"], "tags": ["multifactor_authentication", "mfa_two_factor_categories"], "source": {"title": "Describe the Authentication Capabilities of Microsoft Entra ID", "url": "https://learn.microsoft.com/en-us/training/modules/explore-authentication-capabilities/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-02", "blueprint_leaf_id": "multifactor_authentication", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/explore-authentication-capabilities/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-entra_authentication", "semantic_family_id": "multifactor_authentication", "tested_decision": "mfa_two_factor_categories", "misconception_target": "", "stem_style": "concept_distinction", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-explore-authentication-capabilities"}}
{"id": "sc900_mlc_q041", "exam": "SC-900", "domain": "microsoft_entra", "objective": "entra_access_management", "subobjective": "Describe Microsoft Entra Conditional Access", "difficulty": "intermediate", "type": "multiple_choice", "stem": "Which statement about Conditional Access is correct?", "choices": [{"id": "a", "text": "It is a SIEM that stores all Azure activity logs"}, {"id": "c", "text": "It declares items as records"}, {"id": "b", "text": "It can require a compliant device or MFA when sign-in conditions match"}, {"id": "d", "text": "It is only a DDoS mitigation service"}], "correct_answer": "b", "explanation": "Conditional Access enforces session and grant controls when policy conditions match. It is not SIEM, records management, or DDoS protection.", "references": ["https://learn.microsoft.com/en-us/entra/identity/conditional-access/overview"], "tags": ["conditional_access", "ca_grant_controls_not_siem"], "source": {"title": "Microsoft Entra Conditional Access: Zero Trust Policy Engine - Microsoft Entra ID", "url": "https://learn.microsoft.com/en-us/entra/identity/conditional-access/overview"}, "metadata": {"origin": "manual", "batch": "mlc-batch-02", "blueprint_leaf_id": "conditional_access", "source_authority": "microsoft_docs", "source_urls": ["https://learn.microsoft.com/en-us/entra/identity/conditional-access/overview"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-entra_access_management", "semantic_family_id": "conditional_access_and_identity_protection", "tested_decision": "ca_grant_controls_not_siem", "misconception_target": "", "stem_style": "misconception_correction", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_PRODUCT_DOC_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "doc-conditional-access"}}
{"id": "sc900_mlc_q042", "exam": "SC-900", "domain": "microsoft_entra", "objective": "entra_identity_protection_governance", "subobjective": "Describe the capabilities of Microsoft Entra Privileged Identity Management", "difficulty": "beginner", "type": "multiple_choice", "stem": "Which PIM characteristic most directly supports least privilege for administrators?", "choices": [{"id": "b", "text": "Automatic public IP assignment to VMs"}, {"id": "c", "text": "Disabling authentication"}, {"id": "a", "text": "Just-in-time activation instead of always-on privileged roles"}, {"id": "d", "text": "Publishing ISO reports"}], "correct_answer": "a", "explanation": "Just-in-time activation keeps privileged roles inactive until needed, which is the PIM least-privilege pattern.", "references": ["https://learn.microsoft.com/en-us/training/modules/describe-identity-protection-governance-capabilities/"], "tags": ["privileged_identity_management", "pim_jit_least_privilege"], "source": {"title": "Describe the Identity Protection and Governance Capabilities of Microsoft Entra", "url": "https://learn.microsoft.com/en-us/training/modules/describe-identity-protection-governance-capabilities/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-02", "blueprint_leaf_id": "privileged_identity_management", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/describe-identity-protection-governance-capabilities/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-entra_identity_protection_governance", "semantic_family_id": "privileged_identity_management", "tested_decision": "pim_jit_least_privilege", "misconception_target": "", "stem_style": "direct_concept", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-describe-identity-protection-governance-capabilities"}}
{"id": "sc900_mlc_q043", "exam": "SC-900", "domain": "microsoft_entra", "objective": "entra_identity_protection_governance", "subobjective": "Describe Microsoft Entra ID Protection", "difficulty": "intermediate", "type": "multiple_choice", "stem": "Sign-ins from impossible travel are raising identity risk. Which pairing is the fundamentals-level way Microsoft expects those detections to influence access?", "choices": [{"id": "a", "text": "ID Protection detects the risk; Conditional Access can require controls or block the sign-in"}, {"id": "b", "text": "Azure Bastion hashes the token"}, {"id": "c", "text": "WAF declares a record"}, {"id": "d", "text": "eDiscovery assigns an Entra role"}], "correct_answer": "a", "explanation": "ID Protection produces risk signals; Conditional Access commonly consumes them to require MFA, block, or other grants.", "references": ["https://learn.microsoft.com/en-us/entra/id-protection/overview-identity-protection"], "tags": ["entra_id_protection", "id_protection_feeds_conditional_access"], "source": {"title": "What is Microsoft Entra ID Protection? - Microsoft Entra ID Protection", "url": "https://learn.microsoft.com/en-us/entra/id-protection/overview-identity-protection"}, "metadata": {"origin": "manual", "batch": "mlc-batch-02", "blueprint_leaf_id": "entra_id_protection", "source_authority": "microsoft_docs", "source_urls": ["https://learn.microsoft.com/en-us/entra/id-protection/overview-identity-protection"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-entra_identity_protection_governance", "semantic_family_id": "conditional_access_and_identity_protection", "tested_decision": "id_protection_feeds_conditional_access", "misconception_target": "", "stem_style": "short_scenario", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_PRODUCT_DOC_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "doc-id-protection"}}
{"id": "sc900_mlc_q044", "exam": "SC-900", "domain": "microsoft_entra", "objective": "entra_identity_protection_governance", "subobjective": "Describe access reviews", "difficulty": "intermediate", "type": "multiple_choice", "stem": "Which task is a better fit for access reviews than for Lifecycle Workflows?", "choices": [{"id": "a", "text": "Automatically creating a mailbox on day one of employment"}, {"id": "c", "text": "Mitigating a SYN flood"}, {"id": "d", "text": "Storing TLS certificates"}, {"id": "b", "text": "Asking owners to recertify who still needs a security group"}], "correct_answer": "b", "explanation": "Access reviews recertify existing access. Joiner automation is Lifecycle Workflows. DDoS and Key Vault are unrelated.", "references": ["https://learn.microsoft.com/en-us/entra/id-governance/access-reviews-overview"], "tags": ["access_reviews", "reviews_recertify_not_joiner_provisioning"], "source": {"title": "What are access reviews? - Microsoft Entra - Microsoft Entra ID Governance", "url": "https://learn.microsoft.com/en-us/entra/id-governance/access-reviews-overview"}, "metadata": {"origin": "manual", "batch": "mlc-batch-02", "blueprint_leaf_id": "access_reviews", "source_authority": "microsoft_docs", "source_urls": ["https://learn.microsoft.com/en-us/entra/id-governance/access-reviews-overview"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-entra_identity_protection_governance", "semantic_family_id": "entra_id_governance_and_access_reviews", "tested_decision": "reviews_recertify_not_joiner_provisioning", "misconception_target": "", "stem_style": "concept_distinction", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_PRODUCT_DOC_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "doc-access-reviews"}}
{"id": "sc900_mlc_q045", "exam": "SC-900", "domain": "microsoft_entra", "objective": "entra_identity_types_and_function", "subobjective": "Describe Microsoft Entra ID", "difficulty": "intermediate", "type": "multiple_choice", "stem": "A startup is moving from local application usernames to a cloud directory that can also protect Microsoft 365. Which service should it use?", "choices": [{"id": "b", "text": "Azure Firewall"}, {"id": "a", "text": "Microsoft Entra ID"}, {"id": "c", "text": "Microsoft Purview Records Management"}, {"id": "d", "text": "Defender Vulnerability Management"}], "correct_answer": "a", "explanation": "Entra ID is the cloud directory for users and app access, including Microsoft 365. The other tools are network, records, or vulnerability products.", "references": ["https://learn.microsoft.com/en-us/training/modules/explore-basic-services-identity-types/"], "tags": ["entra_id_overview", "entra_replaces_local_app_directories"], "source": {"title": "Describe the Function and Identity Types of Microsoft Entra ID", "url": "https://learn.microsoft.com/en-us/training/modules/explore-basic-services-identity-types/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-02", "blueprint_leaf_id": "entra_id_overview", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/explore-basic-services-identity-types/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-entra_identity_types_and_function", "semantic_family_id": "entra_hybrid_identity_and_ad", "tested_decision": "entra_replaces_local_app_directories", "misconception_target": "", "stem_style": "short_scenario", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-explore-basic-services-identity-types"}}
{"id": "sc900_mlc_q046", "exam": "SC-900", "domain": "microsoft_entra", "objective": "entra_identity_types_and_function", "subobjective": "Describe types of identities, including agent ID", "difficulty": "intermediate", "type": "multiple_choice", "stem": "Why should an AI agent not share a human user's identity?", "choices": [{"id": "b", "text": "Because agents cannot use HTTPS"}, {"id": "a", "text": "Because agent activity could not be authenticated, authorized, or reviewed separately"}, {"id": "c", "text": "Because Entra ID forbids applications"}, {"id": "d", "text": "Because hashing would stop working"}], "correct_answer": "a", "explanation": "Distinct agent identities exist so automation can be governed on its own. Entra ID already supports app and agent identity types.", "references": ["https://learn.microsoft.com/en-us/training/modules/explore-basic-services-identity-types/"], "tags": ["identity_types_including_agent_id", "agents_need_distinct_identity"], "source": {"title": "Describe the Function and Identity Types of Microsoft Entra ID", "url": "https://learn.microsoft.com/en-us/training/modules/explore-basic-services-identity-types/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-02", "blueprint_leaf_id": "identity_types_including_agent_id", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/explore-basic-services-identity-types/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-entra_identity_types_and_function", "semantic_family_id": "identity_types_including_agent_id", "tested_decision": "agents_need_distinct_identity", "misconception_target": "", "stem_style": "concept_distinction", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-explore-basic-services-identity-types"}}
{"id": "sc900_mlc_q047", "exam": "SC-900", "domain": "microsoft_entra", "objective": "entra_authentication", "subobjective": "Describe the authentication methods", "difficulty": "beginner", "type": "multiple_choice", "stem": "Which option is an Entra authentication method rather than an access-governance feature?", "choices": [{"id": "b", "text": "Access reviews"}, {"id": "c", "text": "Entitlement management catalogs"}, {"id": "a", "text": "Microsoft Authenticator passwordless sign-in"}, {"id": "d", "text": "Lifecycle Workflows"}], "correct_answer": "a", "explanation": "Authenticator is an authentication method. Access reviews, entitlement catalogs, and Lifecycle Workflows govern access over time.", "references": ["https://learn.microsoft.com/en-us/training/modules/explore-authentication-capabilities/"], "tags": ["authentication_methods", "authenticator_is_auth_method_not_governance"], "source": {"title": "Describe the Authentication Capabilities of Microsoft Entra ID", "url": "https://learn.microsoft.com/en-us/training/modules/explore-authentication-capabilities/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-02", "blueprint_leaf_id": "authentication_methods", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/explore-authentication-capabilities/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-entra_authentication", "semantic_family_id": "authentication_methods", "tested_decision": "authenticator_is_auth_method_not_governance", "misconception_target": "", "stem_style": "direct_concept", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-explore-authentication-capabilities"}}
{"id": "sc900_mlc_q048", "exam": "SC-900", "domain": "microsoft_entra", "objective": "entra_authentication", "subobjective": "Describe multifactor authentication (MFA)", "difficulty": "beginner", "type": "multiple_choice", "stem": "An attacker has a user's password but not the user's phone. Which control is intended to stop that sign-in?", "choices": [{"id": "b", "text": "A retention policy"}, {"id": "c", "text": "Azure DDoS Protection"}, {"id": "d", "text": "Content explorer"}, {"id": "a", "text": "Multifactor authentication"}], "correct_answer": "a", "explanation": "MFA requires another factor the attacker likely does not have. Retention, DDoS, and Content explorer do not challenge extra sign-in factors.", "references": ["https://learn.microsoft.com/en-us/entra/identity/authentication/concept-mfa-howitworks"], "tags": ["multifactor_authentication", "mfa_stops_password_replay_without_second_factor"], "source": {"title": "Microsoft Entra multifactor authentication overview - Microsoft Entra ID", "url": "https://learn.microsoft.com/en-us/entra/identity/authentication/concept-mfa-howitworks"}, "metadata": {"origin": "manual", "batch": "mlc-batch-02", "blueprint_leaf_id": "multifactor_authentication", "source_authority": "microsoft_docs", "source_urls": ["https://learn.microsoft.com/en-us/entra/identity/authentication/concept-mfa-howitworks"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-entra_authentication", "semantic_family_id": "multifactor_authentication", "tested_decision": "mfa_stops_password_replay_without_second_factor", "misconception_target": "", "stem_style": "short_scenario", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_PRODUCT_DOC_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "doc-mfa"}}
{"id": "sc900_mlc_q049", "exam": "SC-900", "domain": "security_compliance_identity", "objective": "security_compliance_concepts", "subobjective": "Describe defense-in-depth", "difficulty": "intermediate", "type": "multiple_choice", "stem": "Identity MFA is strong, but a stolen session still reaches plaintext files on a laptop. Which defense-in-depth lesson does this illustrate?", "choices": [{"id": "b", "text": "MFA makes encryption illegal"}, {"id": "a", "text": "One strong layer does not remove the need for data and endpoint controls"}, {"id": "c", "text": "Defense-in-depth applies only to DNS"}, {"id": "d", "text": "Zero Trust forbids laptops"}], "correct_answer": "a", "explanation": "Defense-in-depth expects additional layers such as endpoint protection and data encryption even when identity controls succeed.", "references": ["https://learn.microsoft.com/en-us/training/modules/describe-security-concepts-methodologies/"], "tags": ["defense_in_depth", "identity_layer_not_enough_alone"], "source": {"title": "Describe Security Concepts and Methodologies", "url": "https://learn.microsoft.com/en-us/training/modules/describe-security-concepts-methodologies/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-02", "blueprint_leaf_id": "defense_in_depth", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/describe-security-concepts-methodologies/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-security_compliance_concepts", "semantic_family_id": "defense_in_depth", "tested_decision": "identity_layer_not_enough_alone", "misconception_target": "", "stem_style": "short_scenario", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-describe-security-concepts-methodologies"}}
{"id": "sc900_mlc_q050", "exam": "SC-900", "domain": "security_compliance_identity", "objective": "security_compliance_concepts", "subobjective": "Describe Governance, Risk, and Compliance (GRC) concepts", "difficulty": "beginner", "type": "multiple_choice", "stem": "Leadership wants written policies, assigned owners, and oversight of security decisions. Which GRC concept is that request describing?", "choices": [{"id": "b", "text": "Azure Bastion"}, {"id": "a", "text": "Governance"}, {"id": "c", "text": "Hashing"}, {"id": "d", "text": "Defender for Identity"}], "correct_answer": "a", "explanation": "Governance is the direction-and-control system of policies, owners, and oversight. The other options are technical controls.", "references": ["https://learn.microsoft.com/en-us/training/modules/describe-security-concepts-methodologies/"], "tags": ["grc_concepts", "governance_is_policy_and_oversight"], "source": {"title": "Describe Security Concepts and Methodologies", "url": "https://learn.microsoft.com/en-us/training/modules/describe-security-concepts-methodologies/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-02", "blueprint_leaf_id": "grc_concepts", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/describe-security-concepts-methodologies/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-security_compliance_concepts", "semantic_family_id": "grc_concepts", "tested_decision": "governance_is_policy_and_oversight", "misconception_target": "", "stem_style": "short_scenario", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-describe-security-concepts-methodologies"}}
