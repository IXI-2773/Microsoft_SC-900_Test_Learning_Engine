{"id": "sc900_mlc_q001", "exam": "SC-900", "domain": "security_compliance_identity", "objective": "security_compliance_concepts", "subobjective": "Describe the shared responsibility model", "difficulty": "beginner", "type": "multiple_choice", "stem": "An organization hosts virtual machines in Azure IaaS. Which security duty typically remains with the customer rather than Microsoft?", "choices": [{"id": "a", "text": "Physically securing the datacenter building"}, {"id": "c", "text": "Replacing failed host hardware"}, {"id": "b", "text": "Patching the guest operating system and configuring its access"}, {"id": "d", "text": "Operating the underlying cloud fabric"}], "correct_answer": "b", "explanation": "In IaaS, Microsoft operates the physical host and fabric, while the customer remains responsible for the guest OS, identity, data, and in-guest configuration.", "references": ["https://learn.microsoft.com/en-us/azure/security/fundamentals/shared-responsibility"], "tags": ["shared_responsibility_model", "iaas_guest_os_customer"], "source": {"title": "Shared responsibility in the cloud - Microsoft Azure", "url": "https://learn.microsoft.com/en-us/azure/security/fundamentals/shared-responsibility"}, "metadata": {"origin": "manual", "batch": "mlc-batch-01", "blueprint_leaf_id": "shared_responsibility_model", "source_authority": "microsoft_docs", "source_urls": ["https://learn.microsoft.com/en-us/azure/security/fundamentals/shared-responsibility"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-security_compliance_concepts", "semantic_family_id": "shared_responsibility_model", "tested_decision": "iaas_guest_os_customer", "misconception_target": "all_cloud_duties_transfer", "stem_style": "responsibility_governance", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_PRODUCT_DOC_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "doc-shared-responsibility"}}
{"id": "sc900_mlc_q002", "exam": "SC-900", "domain": "security_compliance_identity", "objective": "security_compliance_concepts", "subobjective": "Describe defense-in-depth", "difficulty": "intermediate", "type": "multiple_choice", "stem": "A company relies on a single perimeter firewall and no additional identity or data controls. Which security model is it failing to apply?", "choices": [{"id": "a", "text": "Federation"}, {"id": "c", "text": "Defense-in-depth"}, {"id": "b", "text": "Records management"}, {"id": "d", "text": "Privileged Identity Management"}], "correct_answer": "c", "explanation": "Defense-in-depth requires multiple independent layers. Depending on one perimeter firewall leaves other layers unprotected if that control fails.", "references": ["https://learn.microsoft.com/en-us/training/modules/describe-security-concepts-methodologies/"], "tags": ["defense_in_depth", "single_layer_is_not_defense_in_depth"], "source": {"title": "Describe Security Concepts and Methodologies", "url": "https://learn.microsoft.com/en-us/training/modules/describe-security-concepts-methodologies/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-01", "blueprint_leaf_id": "defense_in_depth", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/describe-security-concepts-methodologies/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-security_compliance_concepts", "semantic_family_id": "defense_in_depth", "tested_decision": "single_layer_is_not_defense_in_depth", "misconception_target": "", "stem_style": "short_scenario", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-describe-security-concepts-methodologies"}}
{"id": "sc900_mlc_q003", "exam": "SC-900", "domain": "security_compliance_identity", "objective": "security_compliance_concepts", "subobjective": "Describe the Zero Trust model", "difficulty": "beginner", "type": "multiple_choice", "stem": "Which statement best describes a Zero Trust approach to access?", "choices": [{"id": "a", "text": "Trust every request that originates on the corporate network"}, {"id": "c", "text": "Disable authentication after a user is on a VPN"}, {"id": "d", "text": "Replace encryption with network location checks"}, {"id": "b", "text": "Verify explicitly and grant only the access needed, even for internal users"}], "correct_answer": "b", "explanation": "Zero Trust verifies explicitly and uses least privilege instead of assuming that an internal network location is trustworthy.", "references": ["https://learn.microsoft.com/en-us/security/zero-trust/zero-trust-overview"], "tags": ["zero_trust_model", "verify_explicitly_not_network_trust"], "source": {"title": "Zero Trust as a security foundation", "url": "https://learn.microsoft.com/en-us/security/zero-trust/zero-trust-overview"}, "metadata": {"origin": "manual", "batch": "mlc-batch-01", "blueprint_leaf_id": "zero_trust_model", "source_authority": "microsoft_docs", "source_urls": ["https://learn.microsoft.com/en-us/security/zero-trust/zero-trust-overview"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-security_compliance_concepts", "semantic_family_id": "zero_trust_and_identity_perimeter", "tested_decision": "verify_explicitly_not_network_trust", "misconception_target": "", "stem_style": "direct_concept", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_PRODUCT_DOC_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "doc-zero-trust-overview"}}
{"id": "sc900_mlc_q004", "exam": "SC-900", "domain": "security_compliance_identity", "objective": "security_compliance_concepts", "subobjective": "Describe encryption and hashing", "difficulty": "intermediate", "type": "multiple_choice", "stem": "A team needs to confirm a downloaded file was not altered, but it does not need to hide the file contents. Which technique is designed for that integrity check?", "choices": [{"id": "b", "text": "Symmetric encryption of the file"}, {"id": "a", "text": "Hashing"}, {"id": "c", "text": "Issuing a Temporary Access Pass"}, {"id": "d", "text": "Creating a retention label"}], "correct_answer": "a", "explanation": "Hashing produces a one-way fingerprint used to detect change. Encryption hides contents, and the other options are identity or compliance controls.", "references": ["https://learn.microsoft.com/en-us/training/modules/describe-security-concepts-methodologies/"], "tags": ["encryption_and_hashing", "hashing_for_integrity_not_confidentiality"], "source": {"title": "Describe Security Concepts and Methodologies", "url": "https://learn.microsoft.com/en-us/training/modules/describe-security-concepts-methodologies/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-01", "blueprint_leaf_id": "encryption_and_hashing", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/describe-security-concepts-methodologies/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-security_compliance_concepts", "semantic_family_id": "encryption_and_hashing", "tested_decision": "hashing_for_integrity_not_confidentiality", "misconception_target": "", "stem_style": "concept_distinction", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-describe-security-concepts-methodologies"}}
{"id": "sc900_mlc_q005", "exam": "SC-900", "domain": "security_compliance_identity", "objective": "security_compliance_concepts", "subobjective": "Describe Governance, Risk, and Compliance (GRC) concepts", "difficulty": "beginner", "type": "multiple_choice", "stem": "Which GRC activity is primarily about identifying, analyzing, and treating uncertainty that could affect objectives?", "choices": [{"id": "b", "text": "Labeling a document as a record"}, {"id": "c", "text": "Deploying Azure Bastion"}, {"id": "d", "text": "Enabling Microsoft Defender for Endpoint"}, {"id": "a", "text": "Risk management"}], "correct_answer": "a", "explanation": "Risk management is the GRC discipline for identifying and treating risk. The other options are protection or compliance product actions, not the risk process itself.", "references": ["https://learn.microsoft.com/en-us/training/modules/describe-security-concepts-methodologies/"], "tags": ["grc_concepts", "risk_management_vs_product_control"], "source": {"title": "Describe Security Concepts and Methodologies", "url": "https://learn.microsoft.com/en-us/training/modules/describe-security-concepts-methodologies/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-01", "blueprint_leaf_id": "grc_concepts", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/describe-security-concepts-methodologies/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-security_compliance_concepts", "semantic_family_id": "grc_concepts", "tested_decision": "risk_management_vs_product_control", "misconception_target": "", "stem_style": "direct_concept", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-describe-security-concepts-methodologies"}}
{"id": "sc900_mlc_q006", "exam": "SC-900", "domain": "security_compliance_identity", "objective": "identity_concepts", "subobjective": "Define identity as the primary security perimeter", "difficulty": "intermediate", "type": "multiple_choice", "stem": "Users now sign in to SaaS apps from home networks, coffee shops, and mobile devices. Why do security programs treat identity as a primary perimeter?", "choices": [{"id": "a", "text": "Because SaaS apps cannot use encryption"}, {"id": "b", "text": "Because a single trusted office network no longer surrounds every access request"}, {"id": "c", "text": "Because passwords are no longer used anywhere"}, {"id": "d", "text": "Because firewalls cannot be deployed in Azure"}], "correct_answer": "b", "explanation": "Cloud access originates from many networks, so verified identity and contextual access become the practical control point rather than a single office LAN.", "references": ["https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"], "tags": ["identity_primary_security_perimeter", "cloud_access_breaks_network_perimeter"], "source": {"title": "Describe Identity Concepts", "url": "https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-01", "blueprint_leaf_id": "identity_primary_security_perimeter", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-identity_concepts", "semantic_family_id": "zero_trust_and_identity_perimeter", "tested_decision": "cloud_access_breaks_network_perimeter", "misconception_target": "", "stem_style": "short_scenario", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-describe-identity-principles-concepts"}}
{"id": "sc900_mlc_q007", "exam": "SC-900", "domain": "security_compliance_identity", "objective": "identity_concepts", "subobjective": "Define authentication", "difficulty": "beginner", "type": "multiple_choice", "stem": "A sign-in screen asks a user for a password and then a phone approval. What process is occurring?", "choices": [{"id": "a", "text": "Authorization of SharePoint sites"}, {"id": "c", "text": "Records declaration"}, {"id": "d", "text": "Network segmentation"}, {"id": "b", "text": "Authentication of the user's identity"}], "correct_answer": "b", "explanation": "Checking credentials or authentication factors verifies who the user is. That is authentication, not the later decision about what they may access.", "references": ["https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"], "tags": ["authentication", "factors_verify_identity"], "source": {"title": "Describe Identity Concepts", "url": "https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-01", "blueprint_leaf_id": "authentication", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-identity_concepts", "semantic_family_id": "authentication_vs_authorization", "tested_decision": "factors_verify_identity", "misconception_target": "", "stem_style": "direct_concept", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-describe-identity-principles-concepts"}}
{"id": "sc900_mlc_q008", "exam": "SC-900", "domain": "security_compliance_identity", "objective": "identity_concepts", "subobjective": "Define authorization", "difficulty": "intermediate", "type": "multiple_choice", "stem": "A user authenticates successfully but cannot open a finance app. Which process denied the access?", "choices": [{"id": "a", "text": "Hashing"}, {"id": "b", "text": "Federation metadata exchange"}, {"id": "c", "text": "Authorization"}, {"id": "d", "text": "DNS resolution"}], "correct_answer": "c", "explanation": "Authorization evaluates permissions after authentication. A valid sign-in can still be denied if the identity lacks rights to the app.", "references": ["https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"], "tags": ["authorization", "authz_can_deny_after_authn"], "source": {"title": "Describe Identity Concepts", "url": "https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-01", "blueprint_leaf_id": "authorization", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-identity_concepts", "semantic_family_id": "authentication_vs_authorization", "tested_decision": "authz_can_deny_after_authn", "misconception_target": "", "stem_style": "short_scenario", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-describe-identity-principles-concepts"}}
{"id": "sc900_mlc_q009", "exam": "SC-900", "domain": "security_compliance_identity", "objective": "identity_concepts", "subobjective": "Describe identity providers", "difficulty": "beginner", "type": "multiple_choice", "stem": "An application trusts tokens issued by Microsoft Entra ID instead of storing its own local passwords. What role is Entra ID playing?", "choices": [{"id": "a", "text": "Data loss prevention broker"}, {"id": "b", "text": "Identity provider"}, {"id": "c", "text": "SIEM collector"}, {"id": "d", "text": "Web application firewall"}], "correct_answer": "b", "explanation": "An identity provider authenticates users and issues claims/tokens that applications accept. DLP, SIEM, and WAF are different control types.", "references": ["https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"], "tags": ["identity_providers", "idp_issues_trusted_tokens"], "source": {"title": "Describe Identity Concepts", "url": "https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-01", "blueprint_leaf_id": "identity_providers", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-identity_concepts", "semantic_family_id": "federation_and_identity_providers", "tested_decision": "idp_issues_trusted_tokens", "misconception_target": "", "stem_style": "capability_selection", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-describe-identity-principles-concepts"}}
{"id": "sc900_mlc_q010", "exam": "SC-900", "domain": "security_compliance_identity", "objective": "identity_concepts", "subobjective": "Describe the concept of directory services and Active Directory", "difficulty": "beginner", "type": "multiple_choice", "stem": "Which on-premises directory service traditionally stores domain-joined Windows identities and Group Policy objects?", "choices": [{"id": "a", "text": "Microsoft Sentinel"}, {"id": "b", "text": "Azure DDoS Protection"}, {"id": "d", "text": "Microsoft Purview eDiscovery"}, {"id": "c", "text": "Active Directory Domain Services"}], "correct_answer": "c", "explanation": "AD DS is the on-premises directory for domain identities and Group Policy. The other services are SIEM, network, or compliance capabilities.", "references": ["https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"], "tags": ["directory_services_active_directory", "ad_ds_on_prem_directory"], "source": {"title": "Describe Identity Concepts", "url": "https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-01", "blueprint_leaf_id": "directory_services_active_directory", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-identity_concepts", "semantic_family_id": "entra_hybrid_identity_and_ad", "tested_decision": "ad_ds_on_prem_directory", "misconception_target": "", "stem_style": "direct_concept", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-describe-identity-principles-concepts"}}
{"id": "sc900_mlc_q011", "exam": "SC-900", "domain": "security_compliance_identity", "objective": "identity_concepts", "subobjective": "Describe the concept of federation", "difficulty": "intermediate", "type": "multiple_choice", "stem": "A supplier's employees need to access an internal app using the supplier's own sign-in service, without a new local password for each person. Which identity concept enables that trust?", "choices": [{"id": "b", "text": "Azure Bastion"}, {"id": "a", "text": "Federation"}, {"id": "c", "text": "Content explorer"}, {"id": "d", "text": "Defender Vulnerability Management"}], "correct_answer": "a", "explanation": "Federation creates a trust so one organization can accept identities authenticated by another provider, avoiding duplicate local accounts.", "references": ["https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"], "tags": ["federation", "federation_for_partner_access"], "source": {"title": "Describe Identity Concepts", "url": "https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-01", "blueprint_leaf_id": "federation", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-identity_concepts", "semantic_family_id": "federation_and_identity_providers", "tested_decision": "federation_for_partner_access", "misconception_target": "", "stem_style": "short_scenario", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-describe-identity-principles-concepts"}}
{"id": "sc900_mlc_q012", "exam": "SC-900", "domain": "security_compliance_identity", "objective": "security_compliance_concepts", "subobjective": "Describe Governance, Risk, and Compliance (GRC) concepts", "difficulty": "intermediate", "type": "multiple_choice", "stem": "Which statement correctly distinguishes governance from compliance?", "choices": [{"id": "a", "text": "Governance is only a Microsoft Defender XDR incident queue"}, {"id": "b", "text": "Governance sets the organization's chosen rules and oversight; compliance assesses whether internal and external requirements are met"}, {"id": "c", "text": "Compliance replaces the need for encryption"}, {"id": "d", "text": "Governance applies only to on-premises firewalls"}], "correct_answer": "b", "explanation": "Governance is how an organization directs and controls itself. Compliance is the demonstration that obligations and policies are being met.", "references": ["https://learn.microsoft.com/en-us/training/modules/describe-security-concepts-methodologies/"], "tags": ["grc_concepts", "governance_sets_rules_compliance_measures"], "source": {"title": "Describe Security Concepts and Methodologies", "url": "https://learn.microsoft.com/en-us/training/modules/describe-security-concepts-methodologies/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-01", "blueprint_leaf_id": "grc_concepts", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/describe-security-concepts-methodologies/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-security_compliance_concepts", "semantic_family_id": "grc_concepts", "tested_decision": "governance_sets_rules_compliance_measures", "misconception_target": "", "stem_style": "concept_distinction", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-describe-security-concepts-methodologies"}}
{"id": "sc900_mlc_q013", "exam": "SC-900", "domain": "security_compliance_identity", "objective": "security_compliance_concepts", "subobjective": "Describe encryption and hashing", "difficulty": "beginner", "type": "multiple_choice", "stem": "What is the primary purpose of encrypting data at rest?", "choices": [{"id": "a", "text": "To make stored data unreadable without authorized keys"}, {"id": "b", "text": "To replace multifactor authentication"}, {"id": "c", "text": "To create a SIEM incident automatically"}, {"id": "d", "text": "To publish Microsoft audit reports"}], "correct_answer": "a", "explanation": "Encryption protects confidentiality of stored data by requiring keys to read it. It does not replace identity, SIEM, or trust-portal functions.", "references": ["https://learn.microsoft.com/en-us/azure/security/fundamentals/encryption-overview"], "tags": ["encryption_and_hashing", "encryption_confidentiality_at_rest"], "source": {"title": "Azure encryption overview", "url": "https://learn.microsoft.com/en-us/azure/security/fundamentals/encryption-overview"}, "metadata": {"origin": "manual", "batch": "mlc-batch-01", "blueprint_leaf_id": "encryption_and_hashing", "source_authority": "microsoft_docs", "source_urls": ["https://learn.microsoft.com/en-us/azure/security/fundamentals/encryption-overview"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-security_compliance_concepts", "semantic_family_id": "encryption_and_hashing", "tested_decision": "encryption_confidentiality_at_rest", "misconception_target": "", "stem_style": "direct_concept", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_PRODUCT_DOC_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "doc-encryption-azure"}}
{"id": "sc900_mlc_q014", "exam": "SC-900", "domain": "security_compliance_identity", "objective": "security_compliance_concepts", "subobjective": "Describe the Zero Trust model", "difficulty": "intermediate", "type": "multiple_choice", "stem": "Which statement about Zero Trust is correct?", "choices": [{"id": "a", "text": "Zero Trust means never authenticating employees after they join the company"}, {"id": "c", "text": "Zero Trust requires turning off Conditional Access"}, {"id": "b", "text": "Zero Trust assumes a breach is possible and continuously validates requests"}, {"id": "d", "text": "Zero Trust applies only to printers"}], "correct_answer": "b", "explanation": "Assume breach and continuous validation are Zero Trust ideas. It does not mean skipping authentication or disabling access policies.", "references": ["https://learn.microsoft.com/en-us/security/zero-trust/zero-trust-overview"], "tags": ["zero_trust_model", "assume_breach_continuous_validation"], "source": {"title": "Zero Trust as a security foundation", "url": "https://learn.microsoft.com/en-us/security/zero-trust/zero-trust-overview"}, "metadata": {"origin": "manual", "batch": "mlc-batch-01", "blueprint_leaf_id": "zero_trust_model", "source_authority": "microsoft_docs", "source_urls": ["https://learn.microsoft.com/en-us/security/zero-trust/zero-trust-overview"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-security_compliance_concepts", "semantic_family_id": "zero_trust_and_identity_perimeter", "tested_decision": "assume_breach_continuous_validation", "misconception_target": "", "stem_style": "misconception_correction", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_PRODUCT_DOC_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "doc-zero-trust-overview"}}
{"id": "sc900_mlc_q015", "exam": "SC-900", "domain": "security_compliance_identity", "objective": "security_compliance_concepts", "subobjective": "Describe defense-in-depth", "difficulty": "beginner", "type": "multiple_choice", "stem": "Which example best illustrates defense-in-depth?", "choices": [{"id": "b", "text": "Combining identity controls, network filters, endpoint protection, and data encryption"}, {"id": "a", "text": "Using only a long password and no other controls"}, {"id": "c", "text": "Storing all secrets in a public Git repository"}, {"id": "d", "text": "Allowing every inbound port to simplify operations"}], "correct_answer": "b", "explanation": "Defense-in-depth stacks independent controls across layers. A single password or an open network is the opposite pattern.", "references": ["https://learn.microsoft.com/en-us/training/modules/describe-security-concepts-methodologies/"], "tags": ["defense_in_depth", "multiple_independent_layers"], "source": {"title": "Describe Security Concepts and Methodologies", "url": "https://learn.microsoft.com/en-us/training/modules/describe-security-concepts-methodologies/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-01", "blueprint_leaf_id": "defense_in_depth", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/describe-security-concepts-methodologies/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-security_compliance_concepts", "semantic_family_id": "defense_in_depth", "tested_decision": "multiple_independent_layers", "misconception_target": "", "stem_style": "capability_selection", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-describe-security-concepts-methodologies"}}
{"id": "sc900_mlc_q016", "exam": "SC-900", "domain": "security_compliance_identity", "objective": "security_compliance_concepts", "subobjective": "Describe the shared responsibility model", "difficulty": "intermediate", "type": "multiple_choice", "stem": "Under the shared responsibility model, which comparison is accurate as an organization moves from IaaS toward SaaS?", "choices": [{"id": "b", "text": "Microsoft typically takes on more of the underlying platform while the customer still owns data and identities"}, {"id": "a", "text": "The customer becomes responsible for Microsoft's physical hosts"}, {"id": "c", "text": "Identity management disappears"}, {"id": "d", "text": "Encryption is no longer allowed"}], "correct_answer": "b", "explanation": "More managed services shift infrastructure duties to Microsoft, but customers still own their data, identities, and access configuration.", "references": ["https://learn.microsoft.com/en-us/azure/security/fundamentals/shared-responsibility"], "tags": ["shared_responsibility_model", "saas_shifts_platform_not_customer_data"], "source": {"title": "Shared responsibility in the cloud - Microsoft Azure", "url": "https://learn.microsoft.com/en-us/azure/security/fundamentals/shared-responsibility"}, "metadata": {"origin": "manual", "batch": "mlc-batch-01", "blueprint_leaf_id": "shared_responsibility_model", "source_authority": "microsoft_docs", "source_urls": ["https://learn.microsoft.com/en-us/azure/security/fundamentals/shared-responsibility"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-security_compliance_concepts", "semantic_family_id": "shared_responsibility_model", "tested_decision": "saas_shifts_platform_not_customer_data", "misconception_target": "", "stem_style": "concept_distinction", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_PRODUCT_DOC_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "doc-shared-responsibility"}}
{"id": "sc900_mlc_q017", "exam": "SC-900", "domain": "security_compliance_identity", "objective": "identity_concepts", "subobjective": "Define identity as the primary security perimeter", "difficulty": "beginner", "type": "multiple_choice", "stem": "Which change most strongly pushed identity to become a primary security perimeter?", "choices": [{"id": "a", "text": "Applications and users moving outside a single corporate network boundary"}, {"id": "b", "text": "The retirement of encryption"}, {"id": "c", "text": "The requirement that all admins use Telnet"}, {"id": "d", "text": "The removal of authentication from cloud apps"}], "correct_answer": "a", "explanation": "When apps and users left the castle-and-moat network, identity verification became the practical perimeter for access decisions.", "references": ["https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"], "tags": ["identity_primary_security_perimeter", "users_and_apps_left_the_lan"], "source": {"title": "Describe Identity Concepts", "url": "https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-01", "blueprint_leaf_id": "identity_primary_security_perimeter", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-identity_concepts", "semantic_family_id": "zero_trust_and_identity_perimeter", "tested_decision": "users_and_apps_left_the_lan", "misconception_target": "", "stem_style": "direct_concept", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-describe-identity-principles-concepts"}}
{"id": "sc900_mlc_q018", "exam": "SC-900", "domain": "security_compliance_identity", "objective": "identity_concepts", "subobjective": "Define authentication", "difficulty": "intermediate", "type": "multiple_choice", "stem": "Which statement about authentication is correct?", "choices": [{"id": "a", "text": "Authentication decides which files a user may edit"}, {"id": "c", "text": "Authentication verifies claimed identity before access rights are evaluated"}, {"id": "b", "text": "Authentication only applies to printers"}, {"id": "d", "text": "Authentication is the same as data classification"}], "correct_answer": "c", "explanation": "Authentication is identity proofing. Editing rights are authorization, and classification is a data-protection concept.", "references": ["https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"], "tags": ["authentication", "authn_is_not_file_permissions"], "source": {"title": "Describe Identity Concepts", "url": "https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-01", "blueprint_leaf_id": "authentication", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-identity_concepts", "semantic_family_id": "authentication_vs_authorization", "tested_decision": "authn_is_not_file_permissions", "misconception_target": "", "stem_style": "misconception_correction", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-describe-identity-principles-concepts"}}
{"id": "sc900_mlc_q019", "exam": "SC-900", "domain": "security_compliance_identity", "objective": "identity_concepts", "subobjective": "Define authorization", "difficulty": "beginner", "type": "multiple_choice", "stem": "What does authorization determine?", "choices": [{"id": "a", "text": "Whether the presented credentials belong to the claimed identity"}, {"id": "c", "text": "Whether a hash algorithm is collision resistant"}, {"id": "b", "text": "What an already verified identity is allowed to do"}, {"id": "d", "text": "Whether a datacenter has cameras"}], "correct_answer": "b", "explanation": "Authorization is the permission decision after identity has been verified.", "references": ["https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"], "tags": ["authorization", "authorization_is_permission_decision"], "source": {"title": "Describe Identity Concepts", "url": "https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-01", "blueprint_leaf_id": "authorization", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-identity_concepts", "semantic_family_id": "authentication_vs_authorization", "tested_decision": "authorization_is_permission_decision", "misconception_target": "", "stem_style": "direct_concept", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-describe-identity-principles-concepts"}}
{"id": "sc900_mlc_q020", "exam": "SC-900", "domain": "security_compliance_identity", "objective": "identity_concepts", "subobjective": "Describe the concept of federation", "difficulty": "beginner", "type": "multiple_choice", "stem": "What does identity federation establish between organizations?", "choices": [{"id": "a", "text": "A DDoS mitigation anycast network"}, {"id": "c", "text": "A Purview retention schedule"}, {"id": "d", "text": "A Key Vault deletion lock"}, {"id": "b", "text": "A trust so one party can accept identities authenticated by the other"}], "correct_answer": "b", "explanation": "Federation is a trust relationship for cross-organization authentication, not a network, retention, or key-management feature.", "references": ["https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"], "tags": ["federation", "federation_is_identity_trust"], "source": {"title": "Describe Identity Concepts", "url": "https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-01", "blueprint_leaf_id": "federation", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-identity_concepts", "semantic_family_id": "federation_and_identity_providers", "tested_decision": "federation_is_identity_trust", "misconception_target": "", "stem_style": "direct_concept", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-describe-identity-principles-concepts"}}
{"id": "sc900_mlc_q021", "exam": "SC-900", "domain": "microsoft_entra", "objective": "entra_identity_types_and_function", "subobjective": "Describe Microsoft Entra ID", "difficulty": "beginner", "type": "multiple_choice", "stem": "Which Microsoft service is the cloud identity and access management directory used to sign in to Microsoft 365 and many integrated apps?", "choices": [{"id": "a", "text": "Azure Firewall"}, {"id": "c", "text": "Microsoft Purview Audit"}, {"id": "d", "text": "Azure DDoS Protection"}, {"id": "b", "text": "Microsoft Entra ID"}], "correct_answer": "b", "explanation": "Microsoft Entra ID is the cloud IAM directory. Firewall, audit, and DDoS Protection serve other purposes.", "references": ["https://learn.microsoft.com/en-us/entra/fundamentals/whatis"], "tags": ["entra_id_overview", "entra_id_is_cloud_iam"], "source": {"title": "What is Microsoft Entra? - Microsoft Entra", "url": "https://learn.microsoft.com/en-us/entra/fundamentals/whatis"}, "metadata": {"origin": "manual", "batch": "mlc-batch-01", "blueprint_leaf_id": "entra_id_overview", "source_authority": "microsoft_docs", "source_urls": ["https://learn.microsoft.com/en-us/entra/fundamentals/whatis"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-entra_identity_types_and_function", "semantic_family_id": "entra_hybrid_identity_and_ad", "tested_decision": "entra_id_is_cloud_iam", "misconception_target": "", "stem_style": "capability_selection", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_PRODUCT_DOC_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "doc-entra-what-is"}}
{"id": "sc900_mlc_q022", "exam": "SC-900", "domain": "microsoft_entra", "objective": "entra_identity_types_and_function", "subobjective": "Describe types of identities, including agent ID", "difficulty": "intermediate", "type": "multiple_choice", "stem": "An organization deploys AI agents that must call APIs under their own governed identity rather than a shared human mailbox. Which Entra identity type is intended for that pattern?", "choices": [{"id": "b", "text": "Sensitivity label"}, {"id": "c", "text": "NSG rule"}, {"id": "a", "text": "Agent ID"}, {"id": "d", "text": "Retention policy"}], "correct_answer": "a", "explanation": "Agent ID is the Entra identity type for AI agents so they can be authenticated and governed. Labels, NSGs, and retention policies are not identity types.", "references": ["https://learn.microsoft.com/en-us/training/modules/explore-basic-services-identity-types/"], "tags": ["identity_types_including_agent_id", "agent_id_for_ai_agents"], "source": {"title": "Describe the Function and Identity Types of Microsoft Entra ID", "url": "https://learn.microsoft.com/en-us/training/modules/explore-basic-services-identity-types/"}, "metadata": {"origin": "manual", "batch": "mlc-batch-01", "blueprint_leaf_id": "identity_types_including_agent_id", "source_authority": "microsoft_learn", "source_urls": ["https://learn.microsoft.com/en-us/training/modules/explore-basic-services-identity-types/"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-entra_identity_types_and_function", "semantic_family_id": "identity_types_including_agent_id", "tested_decision": "agent_id_for_ai_agents", "misconception_target": "", "stem_style": "current_topic", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_LEARN_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "module-explore-basic-services-identity-types"}}
