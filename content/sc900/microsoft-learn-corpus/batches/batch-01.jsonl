{"id": "sc900_mlc_q024", "exam": "SC-900", "domain": "microsoft_entra", "objective": "entra_authentication", "subobjective": "Describe the authentication methods", "difficulty": "intermediate", "type": "multiple_choice", "stem": "Which Entra authentication method is a phishing-resistant passkey that can replace passwords for sign-in?", "choices": [{"id": "b", "text": "A Purview DLP rule"}, {"id": "c", "text": "A Sentinel playbook"}, {"id": "a", "text": "FIDO2 security key / passkey"}, {"id": "d", "text": "A compliance score action"}], "correct_answer": "a", "explanation": "FIDO2/passkeys are phishing-resistant Entra authentication methods. DLP, playbooks, and compliance score are not authentication methods.", "references": ["https://learn.microsoft.com/en-us/entra/identity/authentication/concept-authentication-methods"], "tags": ["authentication_methods", "fido2_passkey_phishing_resistant"], "source": {"title": "Microsoft Entra authentication overview - Microsoft Entra ID", "url": "https://learn.microsoft.com/en-us/entra/identity/authentication/concept-authentication-methods"}, "metadata": {"origin": "manual", "batch": "mlc-batch-01", "blueprint_leaf_id": "authentication_methods", "source_authority": "microsoft_docs", "source_urls": ["https://learn.microsoft.com/en-us/entra/identity/authentication/concept-authentication-methods"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-entra_authentication", "semantic_family_id": "authentication_methods", "tested_decision": "fido2_passkey_phishing_resistant", "misconception_target": "", "stem_style": "service_selection", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_PRODUCT_DOC_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "doc-authentication-methods"}}
