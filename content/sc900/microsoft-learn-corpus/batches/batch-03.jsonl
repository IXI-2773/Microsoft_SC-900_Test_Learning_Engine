{"id": "sc900_mlc_q066", "exam": "SC-900", "domain": "microsoft_entra", "objective": "entra_access_management", "subobjective": "Describe Microsoft Entra Conditional Access", "difficulty": "intermediate", "type": "multiple_choice", "stem": "The security team wants to block legacy authentication protocols that cannot perform MFA. Which Entra capability is designed for that access decision?", "choices": [{"id": "b", "text": "Records management"}, {"id": "c", "text": "Azure DDoS Protection"}, {"id": "d", "text": "Content explorer"}, {"id": "a", "text": "Conditional Access"}], "correct_answer": "a", "explanation": "Conditional Access can block client apps/legacy protocols that cannot satisfy modern authentication controls such as MFA.", "references": ["https://learn.microsoft.com/en-us/entra/identity/conditional-access/overview"], "tags": ["conditional_access", "ca_blocks_legacy_auth"], "source": {"title": "Microsoft Entra Conditional Access: Zero Trust Policy Engine - Microsoft Entra ID", "url": "https://learn.microsoft.com/en-us/entra/identity/conditional-access/overview"}, "metadata": {"origin": "manual", "batch": "mlc-batch-03", "blueprint_leaf_id": "conditional_access", "source_authority": "microsoft_docs", "source_urls": ["https://learn.microsoft.com/en-us/entra/identity/conditional-access/overview"], "source_retrieved_at": "2026-09-12", "source_family_id": "mlc-entra_access_management", "semantic_family_id": "conditional_access_and_identity_protection", "tested_decision": "ca_blocks_legacy_auth", "misconception_target": "", "stem_style": "short_scenario", "future_probe_suitability": "not_assigned_to_frozen_probe", "authoring_origin": "original_from_official_source", "provenance_category": "MICROSOFT_PRODUCT_DOC_PRIMARY", "currentness_status": "CURRENT", "authority_source_id": "doc-conditional-access"}}
