{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sc900.train-probe-manifest.schema/v1",
  "$comment": "DESIGN-ONLY Phase-2 contract. No runtime selector, scheduler, renderer, history path, analytics path, restore path, or export path is authorized to consume this schema until Gate 3 or later implementation authority explicitly permits it.",
  "title": "SC-900 TRAIN/PROBE manifest design contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "partition_epoch",
    "blueprint_version",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "sc900.train-probe-manifest/v1"
    },
    "partition_epoch": {
      "type": "string",
      "minLength": 1
    },
    "blueprint_version": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "semantic_family_id",
          "source_family_id",
          "role",
          "promotion_status",
          "future_probe_suitability",
          "family_state",
          "assignment_rationale",
          "assignment_receipt",
          "blueprint_version"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "minLength": 1,
            "description": "Immutable canonical question identifier."
          },
          "semantic_family_id": {
            "type": "string",
            "minLength": 1,
            "description": "Conservative transfer/leakage family identifier. Unknown family membership must fail closed outside PROBE."
          },
          "source_family_id": {
            "type": "string",
            "minLength": 1,
            "description": "Official-source family identifier used for sibling-source leakage review."
          },
          "role": {
            "enum": ["TRAIN", "PROBE", "UNASSIGNED"]
          },
          "promotion_status": {
            "enum": ["approved", "pending", "withheld"]
          },
          "future_probe_suitability": {
            "enum": ["eligible", "train_only", "needs_review"]
          },
          "family_state": {
            "enum": ["resolved", "unknown", "disputed", "needs_review"]
          },
          "assignment_rationale": {
            "type": "string",
            "minLength": 1
          },
          "assignment_receipt": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reviewer", "reviewed_at"],
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_at": {
                "type": "string",
                "minLength": 1
              },
              "override_type": {
                "enum": ["none", "family_merge", "family_split", "role_change"]
              },
              "prior_family_ids": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              }
            }
          },
          "blueprint_version": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"role": {"const": "PROBE"}},
              "required": ["role"]
            },
            "then": {
              "properties": {
                "promotion_status": {"const": "approved"},
                "future_probe_suitability": {"const": "eligible"},
                "family_state": {"const": "resolved"}
              }
            }
          }
        ]
      }
    }
  }
}
