{"id":"sc900_p2_q031","exam":"SC-900","domain":"microsoft_security_solutions","objective":"microsoft_sentinel","subobjective":"SIEM and SOAR","difficulty":"beginner","type":"multiple_choice","stem":"Which security operations function is primarily associated with SIEM?","choices":[{"id":"a","text":"Collecting and correlating security data to support detection and investigation"},{"id":"b","text":"Managing document retention labels"},{"id":"c","text":"Issuing user directory roles"},{"id":"d","text":"Providing browser-based RDP to virtual machines"}],"correct_answer":"a","explanation":"SIEM centralizes and analyzes security data to support monitoring, detection, investigation, and security operations. SOAR emphasizes orchestration and automated response.","references":["https://learn.microsoft.com/en-us/training/modules/describe-security-capabilities-of-azure-sentinel/"],"tags":["siem and soar","siem_and_soar"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/describe-security-capabilities-of-azure-sentinel/"},"metadata":{"origin":"manual","batch":"phase2-batch-04","blueprint_leaf_id":"siem_and_soar","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/describe-security-capabilities-of-azure-sentinel/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-microsoft_sentinel","semantic_family_id":"siem_and_soar","stem_style":"distinction_comparison","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
