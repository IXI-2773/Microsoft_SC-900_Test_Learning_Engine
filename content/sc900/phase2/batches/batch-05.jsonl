{"id":"sc900_p2_q041","exam":"SC-900","domain":"microsoft_compliance_solutions","objective":"service_trust_privacy","subobjective":"Microsoft privacy principles","difficulty":"beginner","type":"multiple_choice","stem":"Which statement best aligns with the purpose of Microsoft's privacy principles in the SC-900 trust material?","choices":[{"id":"b","text":"They define Azure subnet routing tables"},{"id":"c","text":"They replace an organization's legal obligations"},{"id":"d","text":"They assign Microsoft Entra administrator roles"},{"id":"a","text":"They describe commitments for handling and protecting customer data and privacy"}],"correct_answer":"a","explanation":"Microsoft's privacy principles describe commitments and practices for respecting privacy and protecting customer data; they do not replace customer compliance obligations.","references":["https://learn.microsoft.com/en-us/training/modules/describe-compliance-management-capabilities-microsoft/"],"tags":["microsoft privacy principles","microsoft_privacy_principles"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/describe-compliance-management-capabilities-microsoft/"},"metadata":{"origin":"manual","batch":"phase2-batch-05","blueprint_leaf_id":"microsoft_privacy_principles","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/describe-compliance-management-capabilities-microsoft/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-service_trust_privacy","semantic_family_id":"microsoft_privacy_principles","stem_style":"direct_concept","future_probe_suitability":"train_only","authoring_origin":"original_from_official_source"}}
{"id":"sc900_p2_q042","exam":"SC-900","domain":"microsoft_compliance_solutions","objective":"purview_compliance_management","subobjective":"Microsoft Purview portal","difficulty":"beginner","type":"multiple_choice","stem":"A compliance administrator wants a central Microsoft interface for accessing Purview data security, governance, risk, and compliance capabilities. Which portal is intended for this purpose?","choices":[{"id":"b","text":"Azure Bastion"},{"id":"c","text":"Microsoft Defender for Endpoint portal only"},{"id":"a","text":"Microsoft Purview portal"},{"id":"d","text":"Microsoft Entra authentication methods"}],"correct_answer":"a","explanation":"The Microsoft Purview portal provides a unified entry point for Microsoft Purview data security, governance, risk, and compliance capabilities.","references":["https://learn.microsoft.com/en-us/training/modules/describe-purview-risk-compliance-governance/"],"tags":["purview portal","purview_portal"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/describe-purview-risk-compliance-governance/"},"metadata":{"origin":"manual","batch":"phase2-batch-05","blueprint_leaf_id":"purview_portal","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/describe-purview-risk-compliance-governance/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-purview_compliance_management","semantic_family_id":"purview_portal","stem_style":"capability_selection","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
{"id":"sc900_p2_q043","exam":"SC-900","domain":"microsoft_compliance_solutions","objective":"purview_compliance_management","subobjective":"compliance score","difficulty":"beginner","type":"multiple_choice","stem":"Which action can improve an organization's Microsoft Purview Compliance Manager compliance score?","choices":[{"id":"b","text":"Creating more Azure subnets"},{"id":"a","text":"Completing applicable recommended improvement actions"},{"id":"c","text":"Increasing the number of guest users"},{"id":"d","text":"Disabling audit logging"}],"correct_answer":"a","explanation":"Compliance score tracks progress associated with recommended improvement actions. Completing applicable actions can increase the score, but the score is not a guarantee of legal compliance.","references":["https://learn.microsoft.com/en-us/purview/compliance-manager-scoring"],"tags":["compliance score","compliance_score"],"source":{"title":"Microsoft documentation","url":"https://learn.microsoft.com/en-us/purview/compliance-manager-scoring"},"metadata":{"origin":"manual","batch":"phase2-batch-05","blueprint_leaf_id":"compliance_score","source_authority":"microsoft_documentation","source_urls":["https://learn.microsoft.com/en-us/purview/compliance-manager-scoring"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-purview_compliance_management","semantic_family_id":"compliance_score","stem_style":"direct_concept","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
{"id":"sc900_p2_q044","exam":"SC-900","domain":"microsoft_compliance_solutions","objective":"purview_information_protection_lifecycle","subobjective":"Content explorer and Activity explorer","difficulty":"beginner","type":"multiple_choice","stem":"A data protection team wants to review a historical view of activities performed on labeled content. Which Microsoft Purview tool is designed for that view?","choices":[{"id":"b","text":"Azure Firewall"},{"id":"c","text":"Microsoft Entra Access Reviews"},{"id":"d","text":"Service Trust Portal"},{"id":"a","text":"Activity explorer"}],"correct_answer":"a","explanation":"Microsoft Purview Activity explorer provides a historical view of activities involving labeled content, using activity information derived from Microsoft 365 audit data.","references":["https://learn.microsoft.com/en-us/purview/data-classification-activity-explorer"],"tags":["content and activity explorer","content_and_activity_explorer"],"source":{"title":"Microsoft documentation","url":"https://learn.microsoft.com/en-us/purview/data-classification-activity-explorer"},"metadata":{"origin":"manual","batch":"phase2-batch-05","blueprint_leaf_id":"content_and_activity_explorer","source_authority":"microsoft_documentation","source_urls":["https://learn.microsoft.com/en-us/purview/data-classification-activity-explorer"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-purview_information_protection_lifecycle","semantic_family_id":"activity_explorer_labeled_content","stem_style":"capability_selection","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
{"id":"sc900_p2_q045","exam":"SC-900","domain":"microsoft_compliance_solutions","objective":"purview_information_protection_lifecycle","subobjective":"records management","difficulty":"beginner","type":"multiple_choice","stem":"An organization must manage high-value documents as formal records for legal and regulatory obligations, including retention and disposition. Which Microsoft Purview capability is the best fit?","choices":[{"id":"b","text":"Microsoft Sentinel"},{"id":"a","text":"Records Management"},{"id":"c","text":"Conditional Access"},{"id":"d","text":"Azure DDoS Protection"}],"correct_answer":"a","explanation":"Microsoft Purview Records Management supports managing business, legal, and regulatory records across their lifecycle, including retention, records declaration, and disposition.","references":["https://learn.microsoft.com/en-us/purview/records-management"],"tags":["records management","records_management"],"source":{"title":"Microsoft documentation","url":"https://learn.microsoft.com/en-us/purview/records-management"},"metadata":{"origin":"manual","batch":"phase2-batch-05","blueprint_leaf_id":"records_management","source_authority":"microsoft_documentation","source_urls":["https://learn.microsoft.com/en-us/purview/records-management"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-purview_information_protection_lifecycle","semantic_family_id":"records_management","stem_style":"short_scenario","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
{"id":"sc900_p2_q046","exam":"SC-900","domain":"microsoft_compliance_solutions","objective":"purview_information_protection_lifecycle","subobjective":"retention policies and labels","difficulty":"beginner","type":"multiple_choice","stem":"A company needs different retention settings for individual documents within the same SharePoint site. Which approach is designed for item-level retention settings?","choices":[{"id":"b","text":"One site-wide retention policy only"},{"id":"a","text":"Retention labels"},{"id":"c","text":"Microsoft Sentinel analytics rules"},{"id":"d","text":"Network security groups"}],"correct_answer":"a","explanation":"Microsoft Purview retention labels can apply retention settings at the item level, whereas retention policies are generally used to apply common settings across broader locations such as sites or mailboxes.","references":["https://learn.microsoft.com/en-us/purview/retention"],"tags":["retention policies labels","retention_policies_labels"],"source":{"title":"Microsoft documentation","url":"https://learn.microsoft.com/en-us/purview/retention"},"metadata":{"origin":"manual","batch":"phase2-batch-05","blueprint_leaf_id":"retention_policies_labels","source_authority":"microsoft_documentation","source_urls":["https://learn.microsoft.com/en-us/purview/retention"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-purview_information_protection_lifecycle","semantic_family_id":"retention_item_level_labels","stem_style":"distinction_comparison","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
{"id":"sc900_p2_q047","exam":"SC-900","domain":"microsoft_compliance_solutions","objective":"purview_information_protection_lifecycle","subobjective":"data classification","difficulty":"beginner","type":"multiple_choice","stem":"What is the main purpose of data classification in Microsoft Purview?","choices":[{"id":"b","text":"Provide remote RDP access to virtual machines"},{"id":"c","text":"Assign privileged directory roles"},{"id":"d","text":"Block distributed denial-of-service traffic"},{"id":"a","text":"Identify and categorize information so sensitive or important data can be understood and protected appropriately"}],"correct_answer":"a","explanation":"Data classification helps organizations identify and categorize information, providing context that supports protection, governance, and compliance decisions.","references":["https://learn.microsoft.com/en-us/training/modules/describe-purview-data-solutions/"],"tags":["data classification","data_classification"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/describe-purview-data-solutions/"},"metadata":{"origin":"manual","batch":"phase2-batch-05","blueprint_leaf_id":"data_classification","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/describe-purview-data-solutions/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-purview_information_protection_lifecycle","semantic_family_id":"data_classification","stem_style":"direct_concept","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
{"id":"sc900_p2_q048","exam":"SC-900","domain":"microsoft_compliance_solutions","objective":"purview_insider_risk_ediscovery_audit","subobjective":"insider risk management","difficulty":"beginner","type":"multiple_choice","stem":"An organization wants policies that correlate relevant signals to identify potentially risky user activity while supporting an investigation workflow. Which Microsoft Purview solution addresses this scenario?","choices":[{"id":"b","text":"Azure Key Vault"},{"id":"c","text":"Microsoft Defender for Endpoint"},{"id":"a","text":"Insider Risk Management"},{"id":"d","text":"Microsoft Entra Password Protection"}],"correct_answer":"a","explanation":"Microsoft Purview Insider Risk Management uses policies and relevant signals to help identify and investigate potentially risky activity associated with insiders.","references":["https://learn.microsoft.com/en-us/training/modules/describe-purview-risk-compliance-governance/"],"tags":["insider risk management","insider_risk_management"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/describe-purview-risk-compliance-governance/"},"metadata":{"origin":"manual","batch":"phase2-batch-05","blueprint_leaf_id":"insider_risk_management","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/describe-purview-risk-compliance-governance/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-purview_insider_risk_ediscovery_audit","semantic_family_id":"insider_risk_management","stem_style":"short_scenario","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
{"id":"sc900_p2_q049","exam":"SC-900","domain":"microsoft_compliance_solutions","objective":"purview_insider_risk_ediscovery_audit","subobjective":"eDiscovery","difficulty":"beginner","type":"multiple_choice","stem":"During litigation, a legal team needs to preserve relevant Microsoft 365 content and then search and review it within a case. Which Microsoft Purview capability should the team use?","choices":[{"id":"b","text":"Data Loss Prevention"},{"id":"c","text":"Azure Firewall"},{"id":"d","text":"Microsoft Entra ID Protection"},{"id":"a","text":"eDiscovery"}],"correct_answer":"a","explanation":"Microsoft Purview eDiscovery supports legal and investigative workflows for preserving, searching, collecting, and reviewing electronically stored information.","references":["https://learn.microsoft.com/en-us/training/modules/describe-purview-risk-compliance-governance/"],"tags":["ediscovery","ediscovery"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/describe-purview-risk-compliance-governance/"},"metadata":{"origin":"manual","batch":"phase2-batch-05","blueprint_leaf_id":"ediscovery","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/describe-purview-risk-compliance-governance/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-purview_insider_risk_ediscovery_audit","semantic_family_id":"ediscovery","stem_style":"short_scenario","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
