{"id":"sc900_p2_q011","exam":"SC-900","domain":"microsoft_entra","objective":"entra_authentication","subobjective":"multifactor authentication","difficulty":"beginner","type":"multiple_choice","stem":"A sign-in requires a password and then approval from a registered device. What security benefit does this provide?","choices":[{"id":"a","text":"It uses more than one authentication factor so a stolen password alone is less likely to be sufficient"},{"id":"b","text":"It gives the user every directory role"},{"id":"c","text":"It guarantees that phishing can never succeed"},{"id":"d","text":"It removes the need for access policies"}],"correct_answer":"a","explanation":"Multifactor authentication requires additional verification beyond a single credential, reducing the chance that compromise of one factor is sufficient for access.","references":["https://learn.microsoft.com/en-us/training/modules/explore-authentication-capabilities/"],"tags":["multifactor authentication","multifactor_authentication"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/explore-authentication-capabilities/"},"metadata":{"origin":"manual","batch":"phase2-batch-02","blueprint_leaf_id":"multifactor_authentication","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/explore-authentication-capabilities/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-entra_authentication","semantic_family_id":"multifactor_authentication","stem_style":"short_scenario","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
{"id":"sc900_p2_q012","exam":"SC-900","domain":"microsoft_entra","objective":"entra_authentication","subobjective":"password protection and management","difficulty":"beginner","type":"multiple_choice","stem":"An organization wants Microsoft Entra password policies to reject organization-specific weak terms in addition to Microsoft's globally banned password list. Which capability is relevant?","choices":[{"id":"a","text":"Custom banned password protection"},{"id":"b","text":"Access reviews"},{"id":"c","text":"Microsoft Sentinel watchlists"},{"id":"d","text":"Retention labels"}],"correct_answer":"a","explanation":"Microsoft Entra Password Protection can use banned-password protections, including organization-specific custom banned terms, to reduce weak password choices.","references":["https://learn.microsoft.com/en-us/training/modules/explore-authentication-capabilities/"],"tags":["password protection management","password_protection_management"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/explore-authentication-capabilities/"},"metadata":{"origin":"manual","batch":"phase2-batch-02","blueprint_leaf_id":"password_protection_management","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/explore-authentication-capabilities/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-entra_authentication","semantic_family_id":"password_protection_management","stem_style":"capability_selection","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
{"id":"sc900_p2_q013","exam":"SC-900","domain":"microsoft_entra","objective":"entra_authentication","subobjective":"authentication methods","difficulty":"beginner","type":"multiple_choice","stem":"Which statement distinguishes a passwordless authentication method from a traditional password sign-in?","choices":[{"id":"a","text":"It can verify the user without requiring the user to enter a password for that sign-in"},{"id":"b","text":"It automatically assigns an administrator role"},{"id":"c","text":"It disables authorization checks"},{"id":"d","text":"It converts the account into a guest identity"}],"correct_answer":"a","explanation":"Passwordless methods authenticate users without requiring them to enter a traditional password during the sign-in flow; authorization and role assignment remain separate concerns.","references":["https://learn.microsoft.com/en-us/training/modules/explore-authentication-capabilities/"],"tags":["authentication methods","authentication_methods"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/explore-authentication-capabilities/"},"metadata":{"origin":"manual","batch":"phase2-batch-02","blueprint_leaf_id":"authentication_methods","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/explore-authentication-capabilities/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-entra_authentication","semantic_family_id":"authentication_methods","stem_style":"distinction_comparison","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
{"id":"sc900_p2_q014","exam":"SC-900","domain":"microsoft_entra","objective":"entra_access_management","subobjective":"Conditional Access","difficulty":"beginner","type":"multiple_choice","stem":"A company wants to require a compliant device before employees can open a sensitive cloud application. Which Microsoft Entra capability applies this conditional access decision?","choices":[{"id":"a","text":"Conditional Access"},{"id":"b","text":"Compliance Manager"},{"id":"c","text":"Azure Key Vault"},{"id":"d","text":"Microsoft Purview eDiscovery"}],"correct_answer":"a","explanation":"Microsoft Entra Conditional Access evaluates signals and conditions and can enforce controls such as requiring a compliant device before access is granted.","references":["https://learn.microsoft.com/en-us/training/modules/explore-access-management-capabilities/"],"tags":["conditional access","conditional_access"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/explore-access-management-capabilities/"},"metadata":{"origin":"manual","batch":"phase2-batch-02","blueprint_leaf_id":"conditional_access","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/explore-access-management-capabilities/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-entra_access_management","semantic_family_id":"conditional_access","stem_style":"short_scenario","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
{"id":"sc900_p2_q015","exam":"SC-900","domain":"microsoft_entra","objective":"entra_access_management","subobjective":"Microsoft Entra roles and RBAC","difficulty":"beginner","type":"multiple_choice","stem":"What does Microsoft Entra role-based access control primarily determine?","choices":[{"id":"a","text":"Which administrative permissions an assigned identity can exercise"},{"id":"b","text":"Which web requests a firewall blocks"},{"id":"c","text":"How long a document is retained"},{"id":"d","text":"Which Sentinel analytics rule detects a threat"}],"correct_answer":"a","explanation":"Microsoft Entra RBAC uses roles to define and assign administrative permissions to identities.","references":["https://learn.microsoft.com/en-us/training/modules/explore-access-management-capabilities/"],"tags":["entra roles rbac","entra_roles_rbac"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/explore-access-management-capabilities/"},"metadata":{"origin":"manual","batch":"phase2-batch-02","blueprint_leaf_id":"entra_roles_rbac","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/explore-access-management-capabilities/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-entra_access_management","semantic_family_id":"entra_roles_rbac","stem_style":"direct_concept","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
{"id":"sc900_p2_q016","exam":"SC-900","domain":"microsoft_entra","objective":"entra_access_management","subobjective":"Conditional Access","difficulty":"beginner","type":"multiple_choice","stem":"A sign-in from an unfamiliar location should be blocked while normal sign-ins remain allowed. Which type of control is best suited to evaluate the sign-in context and apply that decision?","choices":[{"id":"a","text":"Conditional Access policy"},{"id":"b","text":"Sensitivity label policy"},{"id":"c","text":"Network security group"},{"id":"d","text":"Compliance score"}],"correct_answer":"a","explanation":"Conditional Access policies use sign-in signals and conditions to decide whether to block access or require additional controls.","references":["https://learn.microsoft.com/en-us/training/modules/explore-access-management-capabilities/"],"tags":["conditional access","conditional_access"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/explore-access-management-capabilities/"},"metadata":{"origin":"manual","batch":"phase2-batch-02","blueprint_leaf_id":"conditional_access","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/explore-access-management-capabilities/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-entra_access_management","semantic_family_id":"conditional_access","stem_style":"capability_selection","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
{"id":"sc900_p2_q017","exam":"SC-900","domain":"microsoft_entra","objective":"entra_identity_protection_governance","subobjective":"access reviews","difficulty":"beginner","type":"multiple_choice","stem":"A project ends, and the owner needs to recertify which external guests should still have access to the project's group. Which Microsoft Entra capability is designed for this periodic decision?","choices":[{"id":"a","text":"Access reviews"},{"id":"b","text":"Azure Firewall"},{"id":"c","text":"Microsoft Defender for Endpoint"},{"id":"d","text":"Microsoft Purview DLP"}],"correct_answer":"a","explanation":"Access reviews support recurring or one-time review of user and guest access so access that is no longer justified can be removed.","references":["https://learn.microsoft.com/en-us/training/modules/describe-identity-protection-governance-capabilities/"],"tags":["access reviews","access_reviews"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/describe-identity-protection-governance-capabilities/"},"metadata":{"origin":"manual","batch":"phase2-batch-02","blueprint_leaf_id":"access_reviews","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/describe-identity-protection-governance-capabilities/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-entra_identity_protection_governance","semantic_family_id":"access_reviews","stem_style":"short_scenario","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
{"id":"sc900_p2_q018","exam":"SC-900","domain":"microsoft_entra","objective":"entra_identity_protection_governance","subobjective":"Privileged Identity Management","difficulty":"beginner","type":"multiple_choice","stem":"An administrator should become a privileged role member only after activation and approval for a limited period. Which Microsoft Entra capability supports this model?","choices":[{"id":"a","text":"Privileged Identity Management"},{"id":"b","text":"Microsoft Sentinel"},{"id":"c","text":"Service Trust Portal"},{"id":"d","text":"Azure Web Application Firewall"}],"correct_answer":"a","explanation":"Microsoft Entra Privileged Identity Management supports eligible, time-bound privileged role activation and can require controls such as approval.","references":["https://learn.microsoft.com/en-us/training/modules/describe-identity-protection-governance-capabilities/"],"tags":["privileged identity management","privileged_identity_management"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/describe-identity-protection-governance-capabilities/"},"metadata":{"origin":"manual","batch":"phase2-batch-02","blueprint_leaf_id":"privileged_identity_management","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/describe-identity-protection-governance-capabilities/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-entra_identity_protection_governance","semantic_family_id":"privileged_identity_management","stem_style":"short_scenario","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
{"id":"sc900_p2_q019","exam":"SC-900","domain":"microsoft_entra","objective":"entra_identity_protection_governance","subobjective":"Microsoft Entra ID Protection","difficulty":"beginner","type":"multiple_choice","stem":"A security team wants to identify risky users and risky sign-ins and use those risk signals in identity protection decisions. Which capability should it use?","choices":[{"id":"a","text":"Microsoft Entra ID Protection"},{"id":"b","text":"Microsoft Purview Records Management"},{"id":"c","text":"Azure Bastion"},{"id":"d","text":"Microsoft Defender Vulnerability Management"}],"correct_answer":"a","explanation":"Microsoft Entra ID Protection detects identity-related risk, including risky users and sign-ins, and supports risk-based response.","references":["https://learn.microsoft.com/en-us/training/modules/describe-identity-protection-governance-capabilities/"],"tags":["entra id protection","entra_id_protection"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/describe-identity-protection-governance-capabilities/"},"metadata":{"origin":"manual","batch":"phase2-batch-02","blueprint_leaf_id":"entra_id_protection","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/describe-identity-protection-governance-capabilities/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-entra_identity_protection_governance","semantic_family_id":"entra_id_protection","stem_style":"capability_selection","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
{"id":"sc900_p2_q020","exam":"SC-900","domain":"microsoft_entra","objective":"entra_identity_protection_governance","subobjective":"Microsoft Entra ID Governance","difficulty":"beginner","type":"multiple_choice","stem":"Which objective best matches Microsoft Entra ID Governance?","choices":[{"id":"a","text":"Manage identity and access lifecycles so appropriate access can be granted, reviewed, and removed over time"},{"id":"b","text":"Filter inbound HTTP requests to a web application"},{"id":"c","text":"Store cryptographic keys for applications"},{"id":"d","text":"Collect network packets for a SIEM"}],"correct_answer":"a","explanation":"Microsoft Entra ID Governance focuses on governing identity and access lifecycles so access remains appropriate over time.","references":["https://learn.microsoft.com/en-us/training/modules/describe-identity-protection-governance-capabilities/"],"tags":["entra id governance","entra_id_governance"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/describe-identity-protection-governance-capabilities/"},"metadata":{"origin":"manual","batch":"phase2-batch-02","blueprint_leaf_id":"entra_id_governance","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/describe-identity-protection-governance-capabilities/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-entra_identity_protection_governance","semantic_family_id":"entra_id_governance","stem_style":"direct_concept","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
