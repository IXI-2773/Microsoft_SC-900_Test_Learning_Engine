{"id":"sc900_p1_q021","exam":"SC-900","domain":"security_compliance_identity","objective":"identity_concepts","subobjective":"authorization","difficulty":"beginner","type":"multiple_choice","stem":"After a user's identity has been verified, a system checks whether that user may edit a particular record. What is this second check called?","choices":[{"id":"a","text":"Authorization"},{"id":"b","text":"Authentication"},{"id":"c","text":"Federation"},{"id":"d","text":"Hashing"}],"correct_answer":"a","explanation":"Authorization determines what an authenticated identity is permitted to do or access.","references":["https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"],"tags":["authorization","authorization"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"},"metadata":{"origin":"manual","batch":"phase1-batch-03","blueprint_leaf_id":"authorization","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-identity_concepts","semantic_family_id":"authorization","stem_style":"distinction_comparison","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
{"id":"sc900_p1_q022","exam":"SC-900","domain":"microsoft_entra","objective":"entra_authentication","subobjective":"authentication methods","difficulty":"beginner","type":"multiple_choice","stem":"Which statement best describes authentication methods in Microsoft Entra ID?","choices":[{"id":"a","text":"They define how long records are retained"},{"id":"b","text":"They are ways users prove their identity during sign-in"},{"id":"c","text":"They segment Azure virtual networks"},{"id":"d","text":"They calculate Microsoft Purview compliance scores"}],"correct_answer":"b","explanation":"Authentication methods are mechanisms used to verify identity during sign-in, such as passwords and other supported verification methods.","references":["https://learn.microsoft.com/en-us/training/modules/explore-authentication-capabilities/"],"tags":["authentication methods","authentication_methods"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/explore-authentication-capabilities/"},"metadata":{"origin":"manual","batch":"phase1-batch-03","blueprint_leaf_id":"authentication_methods","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/explore-authentication-capabilities/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-entra_authentication","semantic_family_id":"authentication_methods","stem_style":"direct_concept","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
{"id":"sc900_p1_q023","exam":"SC-900","domain":"microsoft_entra","objective":"entra_access_management","subobjective":"entra roles rbac","difficulty":"beginner","type":"multiple_choice","stem":"An administrator should receive only the permissions needed to perform a specific identity-management job. Which concept best supports this?","choices":[{"id":"a","text":"Security information and event management"},{"id":"b","text":"Data residency"},{"id":"c","text":"Microsoft Entra roles and role-based access control"},{"id":"d","text":"Data loss prevention"}],"correct_answer":"c","explanation":"Microsoft Entra roles and RBAC assign permissions according to roles, supporting least-privilege administrative access.","references":["https://learn.microsoft.com/en-us/training/modules/explore-access-management-capabilities/"],"tags":["entra roles","rbac","entra_roles_rbac"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/explore-access-management-capabilities/"},"metadata":{"origin":"manual","batch":"phase1-batch-03","blueprint_leaf_id":"entra_roles_rbac","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/explore-access-management-capabilities/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-entra_access_management","semantic_family_id":"entra_roles_rbac","stem_style":"short_scenario","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
{"id":"sc900_p1_q024","exam":"SC-900","domain":"microsoft_entra","objective":"entra_identity_protection_governance","subobjective":"privileged identity management","difficulty":"beginner","type":"multiple_choice","stem":"A company wants privileged administrative access to be eligible and activated only when needed rather than permanently assigned. Which capability is designed for this?","choices":[{"id":"a","text":"Microsoft Defender for Cloud Apps"},{"id":"b","text":"Microsoft Purview Audit"},{"id":"c","text":"Azure Web Application Firewall"},{"id":"d","text":"Privileged Identity Management"}],"correct_answer":"d","explanation":"Microsoft Entra Privileged Identity Management helps manage, control, and monitor privileged access, including time-bound or just-in-time activation scenarios.","references":["https://learn.microsoft.com/en-us/training/modules/describe-identity-protection-governance-capabilities/"],"tags":["pim","privileged access","privileged_identity_management"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/describe-identity-protection-governance-capabilities/"},"metadata":{"origin":"manual","batch":"phase1-batch-03","blueprint_leaf_id":"privileged_identity_management","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/describe-identity-protection-governance-capabilities/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-entra_identity_protection_governance","semantic_family_id":"privileged_identity_management","stem_style":"short_scenario","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
{"id":"sc900_p1_q025","exam":"SC-900","domain":"microsoft_security_solutions","objective":"azure_infrastructure_security","subobjective":"azure bastion","difficulty":"beginner","type":"multiple_choice","stem":"Administrators need browser-based RDP or SSH access to Azure virtual machines without exposing those virtual machines directly through public IP addresses. Which service fits this scenario?","choices":[{"id":"a","text":"Azure Bastion"},{"id":"b","text":"Azure Key Vault"},{"id":"c","text":"Azure DDoS Protection"},{"id":"d","text":"Microsoft Purview"}],"correct_answer":"a","explanation":"Azure Bastion provides managed RDP and SSH connectivity to virtual machines while reducing the need to expose them directly with public IP addresses.","references":["https://learn.microsoft.com/en-us/training/modules/describe-basic-security-capabilities-azure/"],"tags":["azure bastion","azure_bastion"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/describe-basic-security-capabilities-azure/"},"metadata":{"origin":"manual","batch":"phase1-batch-03","blueprint_leaf_id":"azure_bastion","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/describe-basic-security-capabilities-azure/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-azure_infrastructure_security","semantic_family_id":"azure_bastion","stem_style":"short_scenario","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
