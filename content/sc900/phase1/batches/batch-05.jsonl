{"id":"sc900_p1_q041","exam":"SC-900","domain":"security_compliance_identity","objective":"identity_concepts","subobjective":"federation","difficulty":"beginner","type":"multiple_choice","stem":"Two organizations establish trust so users from one organization can access resources in the other without maintaining separate credentials for every resource. What concept is this?","choices":[{"id":"a","text":"Federation"},{"id":"b","text":"Hashing"},{"id":"c","text":"Data residency"},{"id":"d","text":"Network segmentation"}],"correct_answer":"a","explanation":"Federation establishes trust relationships between identity systems so identities can be used across organizational boundaries.","references":["https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"],"tags":["federation","federation"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"},"metadata":{"origin":"manual","batch":"phase1-batch-05","blueprint_leaf_id":"federation","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/describe-identity-principles-concepts/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-identity_concepts","semantic_family_id":"federation","stem_style":"short_scenario","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
{"id":"sc900_p1_q042","exam":"SC-900","domain":"microsoft_entra","objective":"entra_authentication","subobjective":"multifactor authentication","difficulty":"beginner","type":"multiple_choice","stem":"Why does requiring a second authentication factor generally improve sign-in security compared with a password alone?","choices":[{"id":"a","text":"It automatically grants administrative roles"},{"id":"b","text":"Compromise of one factor is less likely to be sufficient for access"},{"id":"c","text":"It removes the need for authorization"},{"id":"d","text":"It prevents every type of phishing attack"}],"correct_answer":"b","explanation":"Using multiple independent authentication factors reduces reliance on a single credential; compromise of one factor alone is less likely to be enough for access.","references":["https://learn.microsoft.com/en-us/training/modules/explore-authentication-capabilities/"],"tags":["mfa","multifactor_authentication"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/explore-authentication-capabilities/"},"metadata":{"origin":"manual","batch":"phase1-batch-05","blueprint_leaf_id":"multifactor_authentication","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/explore-authentication-capabilities/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-entra_authentication","semantic_family_id":"entra-mfa-benefit","stem_style":"distinction_comparison","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
{"id":"sc900_p1_q043","exam":"SC-900","domain":"microsoft_entra","objective":"entra_identity_protection_governance","subobjective":"entra id governance","difficulty":"beginner","type":"multiple_choice","stem":"Which Microsoft Entra area helps organizations ensure that the right people have the right access to the right resources over time?","choices":[{"id":"a","text":"Microsoft Sentinel"},{"id":"b","text":"Azure DDoS Protection"},{"id":"c","text":"Microsoft Entra ID Governance"},{"id":"d","text":"Microsoft Purview Data Loss Prevention"}],"correct_answer":"c","explanation":"Microsoft Entra ID Governance helps manage identity and access lifecycles so access remains appropriate over time.","references":["https://learn.microsoft.com/en-us/training/modules/describe-identity-protection-governance-capabilities/"],"tags":["id governance","entra_id_governance"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/describe-identity-protection-governance-capabilities/"},"metadata":{"origin":"manual","batch":"phase1-batch-05","blueprint_leaf_id":"entra_id_governance","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/describe-identity-protection-governance-capabilities/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-entra_identity_protection_governance","semantic_family_id":"entra_id_governance","stem_style":"direct_concept","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
