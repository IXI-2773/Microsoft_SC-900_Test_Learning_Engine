{"id":"sc900_p1_q045","exam":"SC-900","domain":"microsoft_security_solutions","objective":"azure_security_management","subobjective":"cloud workload protection","difficulty":"beginner","type":"multiple_choice","stem":"In Microsoft Defender for Cloud, what does cloud workload protection primarily add beyond posture recommendations?","choices":[{"id":"a","text":"Threat protection for running cloud workloads"},{"id":"b","text":"Identity federation between organizations"},{"id":"c","text":"Retention labels for records"},{"id":"d","text":"Legal hold for eDiscovery"}],"correct_answer":"a","explanation":"Cloud workload protection adds threat protection capabilities for workloads, complementing posture management and recommendations.","references":["https://learn.microsoft.com/en-us/training/modules/describe-security-management-capabilities-of-azure/"],"tags":["cloud workload protection","cloud_workload_protection"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/describe-security-management-capabilities-of-azure/"},"metadata":{"origin":"manual","batch":"phase1-batch-05","blueprint_leaf_id":"cloud_workload_protection","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/describe-security-management-capabilities-of-azure/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-azure_security_management","semantic_family_id":"cloud_workload_protection","stem_style":"distinction_comparison","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
{"id":"sc900_p1_q046","exam":"SC-900","domain":"microsoft_security_solutions","objective":"defender_xdr","subobjective":"defender vulnerability management","difficulty":"beginner","type":"multiple_choice","stem":"Which Microsoft Defender capability focuses on discovering, assessing, and prioritizing vulnerabilities and exposure on endpoints?","choices":[{"id":"a","text":"Microsoft Purview eDiscovery"},{"id":"b","text":"Microsoft Defender Vulnerability Management"},{"id":"c","text":"Azure DDoS Protection"},{"id":"d","text":"Microsoft Entra Access Reviews"}],"correct_answer":"b","explanation":"Microsoft Defender Vulnerability Management focuses on vulnerability discovery, assessment, prioritization, and remediation guidance.","references":["https://learn.microsoft.com/en-us/training/modules/describe-threat-protection-with-microsoft-365-defender/"],"tags":["vulnerability management","defender_vulnerability_management"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/describe-threat-protection-with-microsoft-365-defender/"},"metadata":{"origin":"manual","batch":"phase1-batch-05","blueprint_leaf_id":"defender_vulnerability_management","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/describe-threat-protection-with-microsoft-365-defender/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-defender_xdr","semantic_family_id":"defender_vulnerability_management","stem_style":"capability_selection","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
{"id":"sc900_p1_q047","exam":"SC-900","domain":"microsoft_security_solutions","objective":"defender_xdr","subobjective":"defender portal","difficulty":"beginner","type":"multiple_choice","stem":"What is the main value of the Microsoft Defender portal in an XDR environment?","choices":[{"id":"a","text":"It provides browser-based SSH to Azure VMs"},{"id":"b","text":"It stores cryptographic keys for applications"},{"id":"c","text":"It provides a unified experience for security investigation and response across Defender capabilities"},{"id":"d","text":"It calculates Microsoft Purview compliance scores"}],"correct_answer":"c","explanation":"The Microsoft Defender portal provides a unified security operations experience across Microsoft Defender capabilities for investigation and response.","references":["https://learn.microsoft.com/en-us/training/modules/describe-threat-protection-with-microsoft-365-defender/"],"tags":["defender portal","defender_portal"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/describe-threat-protection-with-microsoft-365-defender/"},"metadata":{"origin":"manual","batch":"phase1-batch-05","blueprint_leaf_id":"defender_portal","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/describe-threat-protection-with-microsoft-365-defender/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-defender_xdr","semantic_family_id":"defender_portal","stem_style":"direct_concept","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
{"id":"sc900_p1_q048","exam":"SC-900","domain":"microsoft_compliance_solutions","objective":"purview_compliance_management","subobjective":"compliance score","difficulty":"beginner","type":"multiple_choice","stem":"What does Microsoft Compliance Manager's compliance score represent most directly?","choices":[{"id":"a","text":"A percentage of users who enabled MFA"},{"id":"b","text":"A guaranteed certification that the organization is legally compliant"},{"id":"c","text":"A count of all security incidents detected by Sentinel"},{"id":"d","text":"A measure that helps track progress in completing recommended compliance improvement actions"}],"correct_answer":"d","explanation":"Compliance score helps organizations understand and track progress on recommended improvement actions; it does not itself guarantee legal or regulatory compliance.","references":["https://learn.microsoft.com/en-us/training/modules/explore-plan-compliance-microsoft-365/","https://learn.microsoft.com/en-us/purview/compliance-manager-scoring"],"tags":["compliance score","compliance_score"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/explore-plan-compliance-microsoft-365/"},"metadata":{"origin":"manual","batch":"phase1-batch-05","blueprint_leaf_id":"compliance_score","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/explore-plan-compliance-microsoft-365/","https://learn.microsoft.com/en-us/purview/compliance-manager-scoring"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-purview_compliance_management","semantic_family_id":"compliance_score","stem_style":"distinction_comparison","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
