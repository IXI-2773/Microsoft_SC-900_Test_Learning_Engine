{"id":"sc900_p1_q011","exam":"SC-900","domain":"security_compliance_identity","objective":"security_compliance_concepts","subobjective":"zero trust model","difficulty":"beginner","type":"multiple_choice","stem":"Which statement best reflects the Zero Trust security model?","choices":[{"id":"a","text":"Trust traffic inside the corporate network by default"},{"id":"b","text":"Verify explicitly and use least privilege regardless of network location"},{"id":"c","text":"Permit access permanently after the first successful sign-in"},{"id":"d","text":"Rely on a single perimeter firewall as the main control"}],"correct_answer":"b","explanation":"Zero Trust assumes no implicit trust based on location. It emphasizes explicit verification, least-privilege access, and continuous consideration of risk.","references":["https://learn.microsoft.com/en-us/training/modules/describe-security-concepts-methodologies/"],"tags":["zero trust","zero_trust_model"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/describe-security-concepts-methodologies/"},"metadata":{"origin":"manual","batch":"phase1-batch-02","blueprint_leaf_id":"zero_trust_model","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/describe-security-concepts-methodologies/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-security_compliance_concepts","semantic_family_id":"zero_trust_model","stem_style":"direct_concept","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
{"id":"sc900_p1_q012","exam":"SC-900","domain":"microsoft_entra","objective":"entra_identity_types_and_function","subobjective":"hybrid identity","difficulty":"beginner","type":"multiple_choice","stem":"A company keeps Active Directory Domain Services on-premises while also using Microsoft Entra ID in the cloud and wants a consistent identity across both environments. What concept describes this?","choices":[{"id":"a","text":"Hybrid identity"},{"id":"b","text":"Guest-only identity"},{"id":"c","text":"Data residency"},{"id":"d","text":"Security orchestration"}],"correct_answer":"a","explanation":"Hybrid identity combines on-premises directory identities with cloud identity services so identities can span both environments.","references":["https://learn.microsoft.com/en-us/training/modules/explore-basic-services-identity-types/"],"tags":["hybrid identity","hybrid_identity"],"source":{"title":"Microsoft Learn","url":"https://learn.microsoft.com/en-us/training/modules/explore-basic-services-identity-types/"},"metadata":{"origin":"manual","batch":"phase1-batch-02","blueprint_leaf_id":"hybrid_identity","source_authority":"microsoft_learn","source_urls":["https://learn.microsoft.com/en-us/training/modules/explore-basic-services-identity-types/"],"source_retrieved_at":"2026-09-11","source_family_id":"learn-entra_identity_types_and_function","semantic_family_id":"hybrid_identity","stem_style":"short_scenario","future_probe_suitability":"eligible","authoring_origin":"original_from_official_source"}}
